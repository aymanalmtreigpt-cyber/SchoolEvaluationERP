<Window x:Class="SchoolEvaluationERP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام تقييم موظفي المدارس واحتساب الحوافز الشهرية - الإصدار المؤسسي"
        Height="780" Width="1340"
        MinHeight="520" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource AppBgBrush}"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColSidebar" Width="260" MinWidth="195" MaxWidth="380"/>
            <ColumnDefinition x:Name="ColSidebarSplitter" Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- القائمة الجانبية المرنة -->
        <Border x:Name="SidebarContainer" Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Padding="16,18,16,14" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource PrimaryBrush}" Margin="0,0,10,0">
                            <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="نظام التقييم والحوافز" Foreground="White" FontSize="15.5" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="إدارة المدارس والفروع (LAN)" Foreground="#94A3B8" FontSize="11.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,10,0,8">
                        <TextBlock Text="القوائم الرئيسية للنظام" Foreground="#64748B" FontSize="11.5" FontWeight="Bold" Margin="18,0,0,6"/>

                        <Button x:Name="NavMasterData" Content="🗂️  1. صفحة الأساسيات"
                                Style="{StaticResource SidebarNavButton}" Tag="MasterData"
                                Click="NavButton_Click"/>

                        <Button x:Name="NavIncentiveBasics" Content="💎  2. أساسيات الحوافز"
                                Style="{StaticResource SidebarNavButton}" Tag="IncentiveBasics"
                                Click="NavButton_Click"/>

                        <Button x:Name="NavTemplates" Content="📝  3. قوالب التقييم (A4 / Excel)"
                                Style="{StaticResource SidebarNavButton}" Tag="Templates"
                                Click="NavButton_Click"/>

                        <Button x:Name="NavScoreEntry" Content="✅  4. إدخال التقييمات الشهرية"
                                Style="{StaticResource SidebarNavButton}" Tag="ScoreEntry"
                                Click="NavButton_Click"/>

                        <Button x:Name="NavScoreBalancing" Content="⚖️  5. نسب الموازنة"
                                Style="{StaticResource SidebarNavButton}" Tag="ScoreBalancing"
                                Click="NavButton_Click"/>

                        <Button x:Name="NavHistoryLog" Content="🕒  6. سجل التقييمات والأرشيف"
                                Style="{StaticResource SidebarNavButton}" Tag="HistoryLog"
                                Click="NavButton_Click"/>

                        <Button x:Name="NavFinalReport" Content="💰  7. التقرير النهائي والحوافز"
                                Style="{StaticResource SidebarNavButton}" Tag="FinalReport"
                                Click="NavButton_Click"/>

                        <Separator Background="#1E293B" Margin="14,8"/>

                        <TextBlock Text="الإدارة والأمان" Foreground="#64748B" FontSize="11.5" FontWeight="Bold" Margin="18,0,0,6"/>

                        <Button x:Name="NavUserManagement" Content="🔐  8. المستخدمون والصلاحيات"
                                Style="{StaticResource SidebarNavButton}" Tag="UserManagement"
                                Click="NavButton_Click"/>

                        <Button x:Name="NavDatabaseBackup" Content="💾  9. النسخ الاحتياطي والاستعادة"
                                Style="{StaticResource SidebarNavButton}" Tag="DatabaseBackup"
                                Click="NavButton_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#1E293B" Margin="10" CornerRadius="10" Padding="12">
                    <StackPanel>
                        <TextBlock x:Name="TxtCurrentUserName" Text="مدير النظام العام" Foreground="White" FontWeight="Bold" FontSize="13.5" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtCurrentUserRole" Text="صلاحية كاملة (Admin)" Foreground="#38BDF8" FontSize="11.5" Margin="0,2,0,10" TextWrapping="Wrap"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="🔑 كلمة السر"
                                    Style="{StaticResource SecondaryButton}" Height="32" FontSize="12" Padding="8,0"
                                    Click="BtnChangeOwnPassword_Click"/>

                            <Button Grid.Column="2" Content="خروج"
                                    Style="{StaticResource DangerButton}" Height="32" Padding="12,0" FontSize="12"
                                    Click="BtnLogout_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- فاصل سحب القائمة الجانبية -->
        <GridSplitter x:Name="SidebarSplitter" Grid.Column="1"
                      Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="#CBD5E1" Opacity="0.35" Cursor="SizeWE" ShowsPreview="False"
                      ToolTip="اسحب لتوسيع أو تضييق القائمة الجانبية"/>

        <!-- منطقة عرض الشاشات -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnToggleSidebar" Content="☰ القائمة"
                            Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" FontSize="12.5"
                            ToolTip="إخفاء أو إظهار القائمة الجانبية لتوسيع مساحة العمل"
                            Click="BtnToggleSidebar_Click"/>

                    <TextBlock Grid.Column="2" x:Name="TxtActivePageTitle"
                               Text="صفحة الأساسيات"
                               FontSize="17.5" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>

                    <Border Grid.Column="4" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPermissionsBadge" Text="الصلاحيات: قراءة | إضافة | تعديل | حذف" Foreground="#047857" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" x:Name="MainContentHost" Margin="10"/>
        </Grid>
    </Grid>
</Window>
