<Window x:Class="SchoolEvaluationERP.Views.SyncTemplateEmployeesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مزامنة موظفي الشهر مع أحدث نسخة من القالب"
        Width="1020" Height="700"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Border Style="{StaticResource CardStyle}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 0: العنوان ومعلومات القالب والشهر -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDialogTitle"
                                   Text="🔄 مزامنة موظفي الشهر مع أحدث نسخة من القالب (جميع الأوراق)"
                                   FontSize="17.5" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,4"/>
                        <Border x:Name="BadgePeriodInfo" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,3" Margin="0,0,0,4">
                            <TextBlock x:Name="TxtPeriodInfo" Text="" Foreground="#1E40AF" FontWeight="Bold" FontSize="12"/>
                        </Border>
                    </WrapPanel>

                    <TextBlock Text="تُعرض الفروقات عبر جميع أوراق القالب دفعة واحدة. جميع الخيارات غير محددة افتراضياً لحماية الأرشيف؛ اختر فقط من تريد إضافته أو إزالته من هذا الشهر، ولن يُحفظ أي تغيير في قاعدة البيانات إلا بعد مراجعة الجدول والضغط على (💾 حفظ التعديلات على تقييم الشهر)."
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- 1: شريط البحث السريع -->
                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🔍 بحث سريع بالاسم أو الورقة أو الفرع:"
                                   FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <TextBox Grid.Column="1" x:Name="TxtSearchSync"
                                 Style="{StaticResource ModernTextBox}" Height="32"
                                 TextChanged="TxtSearchSync_TextChanged"/>

                        <Button Grid.Column="2" Content="مسح البحث"
                                Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="8,0,0,0"
                                Click="BtnClearSearch_Click"/>
                    </Grid>
                </Border>

                <!-- 2: قسما المقارنة (الموظفون الجدد في الأعلى + الموظفون المُزالون في الأسفل) -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="160"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="160"/>
                    </Grid.RowDefinitions>

                    <!-- القسم الأول: موظفون مضافون حديثاً في القالب -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#A7F3D0" BorderThickness="1.5" CornerRadius="8" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#ECFDF5" CornerRadius="6" Padding="10,7" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" x:Name="TxtAddedHeader"
                                               Text="➕ موظفون مضافون حديثاً في القالب — غير موجودين في هذا الشهر (0)"
                                               FontSize="13.5" FontWeight="Bold" Foreground="#065F46"
                                               VerticalAlignment="Center" TextWrapping="Wrap"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="BtnSelectAllAdded" Content="✔ تحديد الكل"
                                                Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" FontSize="11.5" Margin="0,0,6,0"
                                                Click="BtnSelectAllAdded_Click"/>
                                        <Button x:Name="BtnUnselectAllAdded" Content="✖ إلغاء التحديد"
                                                Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" FontSize="11.5"
                                                Click="BtnUnselectAllAdded_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="1" x:Name="GridAddedEmployees"
                                      SelectionMode="Single"
                                      CanUserSortColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="إضافة" Width="62">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="الاسم التقييمي للموظف" Binding="{Binding EvaluationName}" ElementStyle="{StaticResource WrappingCellTextStyle}" IsReadOnly="True" Width="*" MinWidth="180"/>
                                    <DataGridTextColumn Header="ورقة القالب" Binding="{Binding SheetDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" IsReadOnly="True" Width="180" MinWidth="130"/>
                                    <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" ElementStyle="{StaticResource WrappingCellTextStyle}" IsReadOnly="True" Width="95"/>
                                    <DataGridTextColumn Header="الفئة" Binding="{Binding CategoryName}" ElementStyle="{StaticResource WrappingCellTextStyle}" IsReadOnly="True" Width="120"/>
                                    <DataGridTextColumn Header="الوظيفة" Binding="{Binding FullJobDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" IsReadOnly="True" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="1" x:Name="EmptyAddedOverlay" Background="#F8FAFC" CornerRadius="6" Visibility="Collapsed">
                                <TextBlock Text="✔ لا يوجد موظفون جدد مضافون للقالب وغير موجودين في هذا الشهر."
                                           Foreground="#64748B" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Row="1" Style="{StaticResource HorizontalGridSplitterStyle}" Height="8" Margin="0,3"/>

                    <!-- القسم الثاني: موظفون أُزيلوا من القالب الحالي -->
                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#FECACA" BorderThickness="1.5" CornerRadius="8" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#FEF2F2" CornerRadius="6" Padding="10,7" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" x:Name="TxtRemovedHeader"
                                               Text="➖ موظفون أُزيلوا من القالب الحالي — ما زالوا موجودين في هذا الشهر (0)"
                                               FontSize="13.5" FontWeight="Bold" Foreground="#991B1B"
                                               VerticalAlignment="Center" TextWrapping="Wrap"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="BtnSelectAllRemoved" Content="✔ تحديد الكل"
                                                Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" FontSize="11.5" Margin="0,0,6,0"
                                                Click="BtnSelectAllRemoved_Click"/>
                                        <Button x:Name="BtnUnselectAllRemoved" Content="✖ إلغاء التحديد"
                                                Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" FontSize="11.5"
                                                Click="BtnUnselectAllRemoved_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="1" x:Name="GridRemovedEmployees"
                                      SelectionMode="Single"
                                      CanUserSortColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="إزالة" Width="62">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="الاسم التقييمي للموظف" Binding="{Binding EvaluationName}" ElementStyle="{StaticResource WrappingCellTextStyle}" IsReadOnly="True" Width="*" MinWidth="180"/>
                                    <DataGridTextColumn Header="الورقة في هذا الشهر" Binding="{Binding SheetDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" IsReadOnly="True" Width="170" MinWidth="125"/>
                                    <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" ElementStyle="{StaticResource WrappingCellTextStyle}" IsReadOnly="True" Width="90"/>
                                    <DataGridTextColumn Header="الدرجة المحفوظة في الشهر" Binding="{Binding SavedScoreDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" IsReadOnly="True" Width="165"/>
                                    <DataGridTextColumn Header="الوظيفة" Binding="{Binding FullJobDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" IsReadOnly="True" Width="135"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="1" x:Name="EmptyRemovedOverlay" Background="#F8FAFC" CornerRadius="6" Visibility="Collapsed">
                                <TextBlock Text="✔ لا يوجد موظفون مُزالون من القالب داخل سجل هذا الشهر."
                                           Foreground="#64748B" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3: الشريط السفلي (ملخص التحديد وأزرار الاعتماد والإلغاء) -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtSelectionSummary"
                                   Text="المحدد حالياً: إضافة (0) موظف  |  إزالة (0) موظف"
                                   FontWeight="Bold" FontSize="13" Foreground="#1E293B"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>

                    <Button Grid.Column="1" x:Name="BtnApplySync"
                            Content="✔ تطبيق التغييرات المختارة على الجدول"
                            Style="{StaticResource PrimaryButton}" Height="40" Padding="18,0" Margin="0,0,8,0"
                            Click="BtnApplySync_Click"/>

                    <Button Grid.Column="2" Content="إلغاء"
                            Style="{StaticResource SecondaryButton}" Height="40" Width="105"
                            IsCancel="True"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
