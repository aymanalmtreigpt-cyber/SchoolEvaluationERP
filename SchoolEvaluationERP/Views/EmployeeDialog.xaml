<Window x:Class="SchoolEvaluationERP.Views.EmployeeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="بيانات الموظف وربط الفئة والمقيمين"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBgBrush}"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">

    <Grid Margin="18">
        <Border Style="{StaticResource CardStyle}" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- العنوان -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock x:Name="TxtDialogTitle" Text="إضافة موظف جديد للنظام" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="أدخل الاسم في النظام (للقيد المحاسبي) والاسم التقييمي (لأوراق التقييم)، واختر الفرع والوظيفة والفئة ليظهر المقيمون تلقائياً." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- الحقول -->
                <StackPanel Grid.Row="1">
                    <!-- الاسم في النظام -->
                    <TextBlock Text="الاسم في النظام (يظهر في عمود الحساب الدائن في القيد النهائي)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtSystemName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"
                             ToolTip="مثال: ابتسام ابراهيم علي الزيادي - استاذة/"/>

                    <!-- الاسم التقييمي -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="الاسم التقييمي (يظهر في أوراق التقييم والبحث السريع)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="نسخ من الاسم في النظام" Style="{StaticResource SecondaryButton}" Height="26" Padding="10,0" FontSize="11.5" Click="BtnCopyFromSystemName_Click"/>
                    </Grid>
                    <TextBox x:Name="TxtEvaluationName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                    <!-- الفرع والوظيفة -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="الفرع (مكان حساب الموظف)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbBranch" Style="{StaticResource ModernComboBox}"
                                      DisplayMemberPath="BranchName" SelectedValuePath="BranchID"
                                      SelectionChanged="CmbBranch_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="الوظيفة" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbJob" Style="{StaticResource ModernComboBox}"
                                      DisplayMemberPath="JobTitle" SelectedValuePath="JobID"/>
                        </StackPanel>
                    </Grid>

                    <!-- الفئة -->
                    <TextBlock Text="الفئة (مرتبطة بالفرع المختار)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbCategory" Style="{StaticResource ModernComboBox}"
                              DisplayMemberPath="DisplayFullName" SelectedValuePath="CategoryID"
                              SelectionChanged="CmbCategory_SelectionChanged" Margin="0,0,0,14"/>

                    <!-- العرض التلقائي لأسماء المقيمين وأوزانهم فور اختيار الفئة -->
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="👥 المقيمون المعتمدون لهذه الفئة وأوزانهم (من 100 درجة):" FontWeight="Bold" Foreground="#1E40AF" FontSize="12.5" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtAutoEvaluatorsPreview" Text="يرجى اختيار الفئة لعرض أسماء المقيمين وأوزانهم تلقائياً..." Foreground="#1E3A8A" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- شريط أزرار الإضافة والحفظ والإلغاء (مثبت وواضح دائماً في الأسفل) -->
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnSaveEmployee" Content="➕ إضافة الموظف وحفظ البيانات"
                            Style="{StaticResource PrimaryButton}" Height="42" FontSize="14.5" IsDefault="True"
                            Click="BtnSaveEmployee_Click"/>

                    <Button Grid.Column="2" Content="إلغاء"
                            Style="{StaticResource SecondaryButton}" Height="42" IsCancel="True"
                            Click="BtnCancel_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
