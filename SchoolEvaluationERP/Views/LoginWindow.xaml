<Window x:Class="SchoolEvaluationERP.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول - نظام تقييم موظفي المدارس والحوافز"
        Height="560" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource AppBgBrush}"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Border Style="{StaticResource CardStyle}" VerticalAlignment="Center" Padding="28">
            <StackPanel>
                <!-- شعار وعنوان النظام -->
                <Border Width="64" Height="64" CornerRadius="16" Background="#EFF6FF" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <TextBlock Text="🏫" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="نظام تقييم الأداء والحوافز الشهرية"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="الإصدار المؤسسي لشبكة المدرسة المحلية (LAN)"
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,22"/>

                <!-- حقل اسم المستخدم -->
                <TextBlock Text="اسم المستخدم" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtUsername" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16" Text="admin"/>

                <!-- حقل كلمة المرور -->
                <TextBlock Text="كلمة المرور" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="TxtPassword" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,14"/>

                <!-- رسالة الخطأ أو التنبيه -->
                <Border x:Name="ErrorBanner" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14" Visibility="Collapsed">
                    <TextBlock x:Name="TxtErrorMessage" Foreground="#B91C1C" FontSize="12.5" TextWrapping="Wrap"/>
                </Border>

                <!-- زر تسجيل الدخول (يدعم الضغط على زر Enter مباشرة) -->
                <Button x:Name="BtnLogin" Content="تسجيل الدخول للنظام"
                        Style="{StaticResource PrimaryButton}"
                        Height="44" FontSize="15"
                        IsDefault="True"
                        Click="BtnLogin_Click"/>

                <Separator Margin="0,20,0,14" Background="#E2E8F0"/>

                <!-- شريط حالة الاتصال بسيرفر الشبكة المحلية LAN -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="LanStatusDot" Width="10" Height="10" Fill="#F59E0B" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtLanStatus" Text="جاري التحقق من اتصال السيرفر..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="BtnTestLan" Content="فحص السيرفر"
                            Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" FontSize="12"
                            Click="BtnTestLan_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
