<Window x:Class="SchoolEvaluationERP.Views.AssignTemplateUsersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تحديد المستخدمين المسؤولين عن القالب"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBgBrush}"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">

    <Grid Margin="18">
        <Border Style="{StaticResource CardStyle}" Padding="20">
            <StackPanel>
                <TextBlock x:Name="TxtDialogTitle"
                           Text="👤 تحديد المستخدمين المسؤولين عن القالب"
                           FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="المستخدمون المضافون هنا هم فقط من يمكنهم رؤية هذا القالب وإدخال درجاته واستعراض أرشيفه (وفق صلاحياتهم في شاشة المستخدمين)، بالإضافة لحساب مدير النظام."
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,14"/>

                <TextBlock Text="اختر حساب مستخدم من النظام ثم اضغط (+ إضافة):" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" x:Name="CmbAvailableUsers"
                              Style="{StaticResource ModernComboBox}" Height="36"
                              DisplayMemberPath="DropdownDisplay" SelectedValuePath="UserID"/>

                    <Button Grid.Column="2" x:Name="BtnAddUser" Content="+ إضافة"
                            Style="{StaticResource PrimaryButton}" Height="36" Padding="16,0" FontSize="13"
                            Click="BtnAddUser_Click"/>
                </Grid>

                <TextBlock x:Name="TxtAvailableUsersNote"
                           Text=""
                           FontSize="11.5" Foreground="#B45309" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>

                <TextBlock x:Name="TxtAssignedListHeader"
                           Text="المستخدمون المسؤولون المضافون (0):"
                           FontWeight="Bold" FontSize="12.5" Foreground="#1E3A8A" Margin="0,4,0,6"/>

                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="8" MinHeight="120" MaxHeight="220" Margin="0,0,0,16">
                    <Grid>
                        <TextBlock x:Name="TxtEmptyAssignedHint"
                                   Text="⚠ لم يتم إسناد أي مستخدم لهذا القالب بعد (سيظهر لحساب المدير فقط)."
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="#B45309"
                                   TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="10"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ListAssignedUsers">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding ListDisplay}"
                                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#0F172A"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <Button Grid.Column="2" Content="🗑"
                                                        Tag="{Binding UserID}"
                                                        Style="{StaticResource DangerButton}"
                                                        Width="32" Height="30" Padding="0" FontSize="13"
                                                        ToolTip="حذف هذا المستخدم من قائمة المسؤولين عن القالب"
                                                        Click="BtnRemoveAssignedUser_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="105"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnSave" Content="💾 حفظ المسؤولين عن القالب"
                            Style="{StaticResource PrimaryButton}" Height="40" FontSize="13.5" IsDefault="True"
                            Click="BtnSave_Click"/>

                    <Button Grid.Column="2" Content="إلغاء"
                            Style="{StaticResource SecondaryButton}" Height="40" IsCancel="True"
                            Click="BtnCancel_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
