<UserControl x:Class="SchoolEvaluationERP.Views.MasterDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI">

    <Grid Margin="4">
        <TabControl Background="Transparent" BorderThickness="0" FontSize="14">

            <!-- ========================================================================= -->
            <!-- التبويب الأول: البيانات الأساسية (الفروع، الوظائف، المقيمين، الفئات 100 درجة) -->
            <!-- ========================================================================= -->
            <TabItem Header="  🏢 1. البيانات الأساسية والفئات (الفروع / الوظائف / المقيمين / الفئات)  " Padding="14,8" FontWeight="Bold">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <!-- الصف العلوي: البطاقات الثلاث المستقلة (الفروع، الوظائف، المقيمين) -->
                        <RowDefinition Height="1.05*"/>
                        <RowDefinition Height="16"/>
                        <!-- الصف السفلي: جدول الفئات المرتبطة بالفرع والمقيمين بشرط 100 درجة -->
                        <RowDefinition Height="1.15*"/>
                    </Grid.RowDefinitions>

                    <!-- البطاقات الثلاث المستقلة -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1. بطاقة الفروع -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="📍 الفروع (مكان حساب الموظف)" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtBranchName" Style="{StaticResource ModernTextBox}" ToolTip="اكتب اسم الفرع (مثل: الحصبة)"/>
                                    <Button Grid.Column="2" x:Name="BtnSaveBranch" Content="حفظ" Style="{StaticResource PrimaryButton}" Height="38" Padding="14,0" Click="BtnSaveBranch_Click"/>
                                    <Button Grid.Column="4" x:Name="BtnDeleteBranch" Content="حذف" Style="{StaticResource DangerButton}" Height="38" Padding="12,0" Click="BtnDeleteBranch_Click"/>
                                </Grid>

                                <DataGrid Grid.Row="2" x:Name="GridBranches" IsReadOnly="True" SelectionChanged="GridBranches_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="اسم الفرع" Binding="{Binding BranchName}" Width="*"/>
                                        <DataGridTextColumn Header="الفئات" Binding="{Binding CategoriesCount}" Width="65"/>
                                        <DataGridTextColumn Header="الموظفون" Binding="{Binding EmployeesCount}" Width="75"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- 2. بطاقة الوظائف -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="💼 المسميات الوظيفية" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtJobTitle" Style="{StaticResource ModernTextBox}" ToolTip="اكتب اسم الوظيفة (مثل: معلم، مشرف)"/>
                                    <Button Grid.Column="2" x:Name="BtnSaveJob" Content="حفظ" Style="{StaticResource PrimaryButton}" Height="38" Padding="14,0" Click="BtnSaveJob_Click"/>
                                    <Button Grid.Column="4" x:Name="BtnDeleteJob" Content="حذف" Style="{StaticResource DangerButton}" Height="38" Padding="12,0" Click="BtnDeleteJob_Click"/>
                                </Grid>

                                <DataGrid Grid.Row="2" x:Name="GridJobs" IsReadOnly="True" SelectionChanged="GridJobs_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="اسم الوظيفة" Binding="{Binding JobTitle}" Width="*"/>
                                        <DataGridTextColumn Header="الموظفون" Binding="{Binding EmployeesCount}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- 3. بطاقة المقيمين -->
                        <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="👤 أسماء المقيمين والمسؤولين" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtEvaluatorName" Style="{StaticResource ModernTextBox}" ToolTip="اكتب اسم المقيم (المشرف أو الإداري)"/>
                                    <Button Grid.Column="2" x:Name="BtnSaveEvaluator" Content="حفظ" Style="{StaticResource PrimaryButton}" Height="38" Padding="14,0" Click="BtnSaveEvaluator_Click"/>
                                    <Button Grid.Column="4" x:Name="BtnDeleteEvaluator" Content="حذف" Style="{StaticResource DangerButton}" Height="38" Padding="12,0" Click="BtnDeleteEvaluator_Click"/>
                                </Grid>

                                <DataGrid Grid.Row="2" x:Name="GridEvaluators" IsReadOnly="True" SelectionChanged="GridEvaluators_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="اسم المقيم" Binding="{Binding EvaluatorName}" Width="*"/>
                                        <DataGridTextColumn Header="الفئات المسندة" Binding="{Binding AssignedCategoriesCount}" Width="105"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- الصف السفلي: بطاقة الفئات المرتبطة بالفرع والمقيمين (100 درجة) -->
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🏷️ الفئات وتوزيع درجات المقيمين (شرط المجموع = 100 درجة لكل فئة وفرع)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="اضغط على (+ إنشاء فئة جديدة) لتحديد اسم الفئة والفرع واختيار المقيمين عبر (CheckBox) وتوزيع الـ 100 درجة بينهم." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,16,0"/>
                                </StackPanel>

                                <Button Grid.Column="1" x:Name="BtnAddCategoryPopup" Content="+ إنشاء فئة جديدة (100 درجة)"
                                        Style="{StaticResource PrimaryButton}" Height="38"
                                        Click="BtnAddCategoryPopup_Click"/>

                                <Button Grid.Column="3" x:Name="BtnEditCategoryPopup" Content="✏ تعديل الفئة وأوزانها"
                                        Style="{StaticResource SecondaryButton}" Height="38"
                                        Click="BtnEditCategoryPopup_Click"/>

                                <Button Grid.Column="5" x:Name="BtnDeleteCategory" Content="🗑 حذف الفئة"
                                        Style="{StaticResource DangerButton}" Height="38" Padding="14,0"
                                        Click="BtnDeleteCategory_Click"/>
                            </Grid>

                            <DataGrid Grid.Row="1" x:Name="GridCategories" IsReadOnly="True" MouseDoubleClick="GridCategories_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="اسم الفئة" Binding="{Binding CategoryName}" Width="140"/>
                                    <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" Width="130"/>
                                    <DataGridTextColumn Header="المقيمون المعتمدون وتوزيع الدرجات (من 100)" Binding="{Binding EvaluatorsSummary}" Width="*"/>
                                    <DataGridTextColumn Header="مجموع الأوزان" Binding="{Binding TotalWeights}" Width="100"/>
                                    <DataGridTextColumn Header="عدد الموظفين" Binding="{Binding EmployeesCount}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- التبويب الثاني: سجل الموظفين الشامل (الاسم في النظام + التقييمي + Excel)   -->
            <!-- ========================================================================= -->
            <TabItem Header="  👨‍🏫 2. سجل الموظفين واستيراد ملفات Excel (الاسم في النظام والاسم التقييمي)  " Padding="14,8" FontWeight="Bold">
                <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- شريط الأزرار العلوي للموظفين والإكسل -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="إدارة الموظفين وربطهم بالفروع والفئات والمقيمين" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="يمكنك إضافة الموظفين يدوياً عبر النافذة المنبثقة أو استيرادهم دفعة واحدة من ملف Excel." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,16,0"/>
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="BtnAddEmployeePopup" Content="+ إضافة موظف جديد"
                                    Style="{StaticResource PrimaryButton}" Height="38"
                                    Click="BtnAddEmployeePopup_Click"/>

                            <Button Grid.Column="3" x:Name="BtnEditEmployeePopup" Content="✏ تعديل الموظف"
                                    Style="{StaticResource SecondaryButton}" Height="38"
                                    Click="BtnEditEmployeePopup_Click"/>

                            <Button Grid.Column="5" x:Name="BtnDeleteEmployee" Content="🗑 حذف"
                                    Style="{StaticResource DangerButton}" Height="38" Padding="14,0"
                                    Click="BtnDeleteEmployee_Click"/>

                            <Button Grid.Column="7" x:Name="BtnImportExcel" Content="📥 استيراد من Excel"
                                    Style="{StaticResource SecondaryButton}" Height="38"
                                    Click="BtnImportExcel_Click"/>

                            <Button Grid.Column="9" x:Name="BtnDownloadExcelTemplate" Content="📄 تحميل قالب Excel فارغ"
                                    Style="{StaticResource SecondaryButton}" Height="38"
                                    Click="BtnDownloadExcelTemplate_Click"/>
                        </Grid>

                        <!-- شريط البحث والفلترة -->
                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" x:Name="TxtSearchEmployee" Style="{StaticResource ModernTextBox}"
                                         ToolTip="ابحث بالاسم التقييمي أو الاسم في النظام أو الوظيفة..."
                                         TextChanged="TxtSearchEmployee_TextChanged"/>

                                <ComboBox Grid.Column="2" x:Name="CmbFilterBranch" Style="{StaticResource ModernComboBox}"
                                          DisplayMemberPath="BranchName" SelectedValuePath="BranchID"
                                          SelectionChanged="CmbFilterBranch_SelectionChanged"/>

                                <Button Grid.Column="4" Content="عرض الكل" Style="{StaticResource SecondaryButton}" Height="38" Click="BtnResetEmployeeFilters_Click"/>

                                <TextBlock Grid.Column="6" x:Name="TxtEmployeesCountBadge" Text="إجمالي الموظفين: 0" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- جدول الموظفين الشامل مع المقيمين ومؤشر اكتمال النصاب -->
                        <DataGrid Grid.Row="2" x:Name="GridEmployees" IsReadOnly="True" MouseDoubleClick="GridEmployees_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم التقييمي (لأوراق التقييم)" Binding="{Binding EvaluationName}" Width="175"/>
                                <DataGridTextColumn Header="الاسم في النظام (للقيد المحاسبي)" Binding="{Binding SystemName}" Width="230"/>
                                <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" Width="105"/>
                                <DataGridTextColumn Header="الوظيفة" Binding="{Binding JobTitle}" Width="105"/>
                                <DataGridTextColumn Header="الفئة" Binding="{Binding CategoryName}" Width="105"/>
                                <DataGridTextColumn Header="المقيمون التلقائيون للفئة (100 درجة)" Binding="{Binding AssignedEvaluatorsSummary}" Width="*"/>
                                <DataGridTextColumn Header="حالة الإدراج في قوالب التقييم" Binding="{Binding TemplateCoverageStatus}" Width="210"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

