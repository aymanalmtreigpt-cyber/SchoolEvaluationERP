<Window x:Class="SchoolEvaluationERP.Views.EditCriteriaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تخصيص مبدأ التقييم ودرجته الصحيحة"
        Width="450" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBgBrush}"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">

    <Grid Margin="18">
        <Border Style="{StaticResource CardStyle}" Padding="22">
            <StackPanel>
                <TextBlock Text="تعديل قاعدة / مبدأ التقييم" FontSize="17.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="TxtRemainingHint" Text="أدخل اسم مبدأ التقييم وحدد درجته القصوى (عدد صحيح بدون كسور) بحيث يصبح مجموع الورقة = 100 درجة."
                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,16"/>

                <TextBlock Text="تسمية مبدأ التقييم:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtCriteriaTitle" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="درجة التقييم لهذا المبدأ (عدد صحيح من 100):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="BtnUseRemaining" Content="وضع المتبقي للـ 100" Style="{StaticResource SecondaryButton}" Height="26" Padding="8,0" FontSize="11.5" Click="BtnUseRemaining_Click"/>
                </Grid>
                <TextBox x:Name="TxtMaxScore" Style="{StaticResource ModernTextBox}" Margin="0,0,0,18"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="💾 اعتماد المبدأ والدرجة"
                            Style="{StaticResource PrimaryButton}" Height="40" IsDefault="True"
                            Click="BtnSave_Click"/>

                    <Button Grid.Column="2" x:Name="BtnDeleteCol" Content="🗑 حذف العمود"
                            Style="{StaticResource DangerButton}" Height="40" Padding="12,0"
                            Click="BtnDeleteCol_Click"/>

                    <Button Grid.Column="4" Content="إلغاء"
                            Style="{StaticResource SecondaryButton}" Height="40" IsCancel="True"
                            Click="BtnCancel_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
