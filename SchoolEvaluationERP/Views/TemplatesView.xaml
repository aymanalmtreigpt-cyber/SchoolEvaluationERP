<UserControl x:Class="SchoolEvaluationERP.Views.TemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI">

    <Grid Margin="4">
        <TabControl x:Name="MainTemplatesTabControl" Background="Transparent" BorderThickness="0" FontSize="14">

            <!-- التبويب الأول: 1. قائمة قوالب التقييمات -->
            <TabItem Header="  📂 1. قائمة قوالب التقييمات  " Padding="14,8" FontWeight="Bold">
                <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="إدارة قوالب التقييم متعددة الأوراق (نظام حفظ النسخ التلقائي Versioning)"
                                           FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="اضغط مرتين على أي قالب (أو اضغط زر عرض القالب) لفتحه في وضع القراءة فقط، وللتعديل حدد القالب واضغط (✏ فتح وتعديل القالب). يمكنك تحديد عدة قوالب عبر الماوس أو Ctrl أو Shift."
                                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>

                            <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="BtnCreateNewTemplate" Content="+ إنشاء قالب تقييم جديد"
                                        Style="{StaticResource PrimaryButton}" Height="38" Margin="0,0,8,6"
                                        Click="BtnCreateNewTemplate_Click"/>

                                <Button x:Name="BtnOpenSelectedTemplate" Content="✏ فتح وتعديل القالب"
                                        Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,8,6"
                                        Click="BtnOpenSelectedTemplate_Click"/>

                                <Button x:Name="BtnPrintSelectedTemplatePdf" Content="🖨 طباعة استمارة A4 (PDF)"
                                        Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,8,6"
                                        Click="BtnPrintSelectedTemplatePdf_Click"/>

                                <Button x:Name="BtnDeleteSelectedTemplate" Content="🗑 حذف المحدد"
                                        Style="{StaticResource DangerButton}" Height="38" Padding="14,0" Margin="0,0,0,6"
                                        Click="BtnDeleteSelectedTemplate_Click"/>
                            </WrapPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="🔍 بحث باسم المقيم:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="2" x:Name="TxtSearchTemplateEvaluator" Style="{StaticResource ModernTextBox}"
                                         ToolTip="اكتب اسم المقيم لفلترة القوالب..."
                                         TextChanged="TxtSearchTemplateEvaluator_TextChanged"/>
                                <Button Grid.Column="4" Content="عرض الكل" Style="{StaticResource SecondaryButton}" Height="38" Click="BtnResetTemplateSearch_Click"/>
                                <TextBlock Grid.Column="6" x:Name="TxtTemplatesCountBadge" Text="إجمالي القوالب الفعالة: 0" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="2" x:Name="GridSavedTemplates"
                                  IsReadOnly="True"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  SelectionChanged="GridSavedTemplates_SelectionChanged"
                                  MouseDoubleClick="GridSavedTemplates_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم القالب" Binding="{Binding TemplateID}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="80"/>
                                <DataGridTextColumn Header="اسم المقيم المسؤول" Binding="{Binding EvaluatorName}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="165"/>
                                <DataGridTextColumn Header="النسخة" Binding="{Binding VersionDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="85"/>
                                <DataGridTextColumn Header="عدد الأوراق" Binding="{Binding SheetsCount}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="85"/>
                                <DataGridTextColumn Header="إجمالي الموظفين" Binding="{Binding TotalEmployeesCount}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="105"/>
                                <DataGridTextColumn Header="تفاصيل الأوراق والفئات داخل القالب" Binding="{Binding SheetsSummary}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="*"/>
                                <DataGridTextColumn Header="حالة الارتباط والأمان" Binding="{Binding StatusDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="210"/>
                                <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding CreatedAtDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="100"/>
                                <DataGridTemplateColumn Header="معاينة القراءة" Width="115">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="👁 عرض القالب"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Height="30" Padding="8,0" FontSize="12"
                                                    ToolTip="فتح القالب في صفحة التصميم بوضع القراءة فقط"
                                                    Click="BtnRowViewReadOnly_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- التبويب الثاني: 2. تصميم قالب التقييم -->
            <TabItem x:Name="TabTemplateDesigner" Header="  🛠️ 2. تصميم قالب التقييم  " Padding="14,8" FontWeight="Bold">
                <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 0: الشريط العلوي (تمت إزالة زر + قالب جديد لمقيم، ومنع تغطية الكلام تحت الأزرار) -->
                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtDesignerHeaderTitle"
                                                   Text="لم يتم فتح قالب بعد — اختر قالباً من القائمة أو أنشئ قالباً جديداً"
                                                   FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,4"/>

                                        <Border x:Name="BadgeSheetCategory" Background="#DBEAFE" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="6" Padding="10,3" Margin="0,0,8,4" Visibility="Collapsed">
                                            <TextBlock x:Name="TxtActiveSheetCategoryBadge" Text="الفئة: معلم" Foreground="#1E40AF" FontWeight="Bold" FontSize="12.5" TextWrapping="Wrap"/>
                                        </Border>

                                        <Border x:Name="BadgeReadOnlyMode" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="6" Padding="10,3" Margin="0,0,0,4" Visibility="Collapsed">
                                            <TextBlock x:Name="TxtReadOnlyBadge" Text="🔒 وضع القراءة فقط (للتعديل حدد القالب من القائمة واضغط فتح وتعديل القالب)" Foreground="#92400E" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"/>
                                        </Border>
                                    </WrapPanel>

                                    <TextBlock x:Name="TxtDesignerSubStatus"
                                               Text="يمكنك إضافة عدة أوراق تقييم داخل نفس القالب، وتخصيص أعمدة المبادئ (100 درجة) لكل ورقة."
                                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnDesignerPrintPdf" Content="🖨 تصدير وطباعة A4 (PDF)"
                                            Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,8,0" IsEnabled="False"
                                            Click="BtnDesignerPrintPdf_Click"/>

                                    <Button x:Name="BtnDesignerSaveTemplate" Content="💾 حفظ واعتماد القالب بالكامل"
                                            Style="{StaticResource PrimaryButton}" Height="38" IsEnabled="False"
                                            Click="BtnDesignerSaveTemplate_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 1: شريط أعمدة مبادئ التقييم التفاعلي مع التفاف النص التلقائي لعدم تغطيته بالشارات -->
                        <Border Grid.Row="1" x:Name="PanelCriteriaDesigner" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" IsEnabled="False">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="📐 أعمدة مبادئ التقييم للورقة الحالية:" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="(اضغط على اسم أي عمود لتسميته وتحديد درجته، أو اضغط على زر [+] بين أي عمودين لإدراج عمود جديد في ذلك الموضع)"
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" x:Name="BannerSheetCriteriaSum" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSheetCriteriaSum" Text="مجموع درجات الأعمدة: 0 من 100 درجة" FontWeight="Bold" FontSize="12.5" Foreground="#B45309"/>
                                    </Border>

                                    <Button Grid.Column="4" Content="⚖ توزيع الـ 100 درجة بالتساوي"
                                            Style="{StaticResource SecondaryButton}" Height="32" Padding="10,0" FontSize="12" VerticalAlignment="Center"
                                            ToolTip="توزيع 100 درجة بالتساوي على جميع أعمدة الورقة الحالية"
                                            Click="BtnDistributeCriteriaEqually_Click"/>
                                </Grid>

                                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="StackInteractiveColumns" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- 2: شريط البحث التلقائي وإضافة موظفي الفئة للورقة الحالية -->
                        <Border Grid.Row="2" x:Name="PanelEmployeeAdder" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10" IsEnabled="False">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="👤 إضافة موظف للورقة:" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <ComboBox Grid.Column="2" x:Name="CmbSearchCategoryEmployees"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEditable="True" StaysOpenOnEdit="True"
                                          DisplayMemberPath="EvaluationName" SelectedValuePath="EmployeeID"
                                          ToolTip="اكتب جزءاً من اسم الموظف أو اختره من القائمة المنسدلة (يعرض فقط موظفي فئة هذه الورقة)"/>

                                <Button Grid.Column="4" Content="+ إدراج الموظف"
                                        Style="{StaticResource PrimaryButton}" Height="36" Padding="12,0" FontSize="12.5"
                                        Click="BtnAddSelectedEmployeeToSheet_Click"/>

                                <Button Grid.Column="6" x:Name="BtnAddAllCategoryEmployees" Content="⚡ إدراج جميع موظفي الفئة"
                                        Style="{StaticResource SecondaryButton}" Height="36" Padding="12,0" FontSize="12.5"
                                        Click="BtnAddAllCategoryEmployees_Click"/>

                                <Button Grid.Column="8" Content="🗑 إزالة المحدد من الورقة"
                                        Style="{StaticResource DangerButton}" Height="36" Padding="12,0" FontSize="12.5"
                                        ToolTip="يمكنك تحديد موظف أو عدة موظفين بالماوس أو Ctrl أو Shift وإزالتهم دفعة واحدة"
                                        Click="BtnRemoveEmployeeFromSheet_Click"/>
                            </Grid>
                        </Border>

                        <!-- 3: جدول معاينة الورقة الحالية (خلايا المبادئ فارغة وتدعم التحديد المتعدد والتفاف النص) -->
                        <DataGrid Grid.Row="3" x:Name="GridSheetPreview"
                                  IsReadOnly="True"
                                  CanUserSortColumns="False"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"/>

                        <!-- 4: الشريط السفلي لأوراق العمل المتعددة بلون أزرق ثلجي فاتح ومريح للعين بدلاً من الأسود -->
                        <Border Grid.Row="4" x:Name="PanelBottomSheetsBar" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.5" CornerRadius="8" Padding="12,8" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="📑 أوراق القالب:" Foreground="#1E3A8A" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0"/>

                                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="StackSheetTabs" Orientation="Horizontal" VerticalAlignment="Center"/>
                                </ScrollViewer>

                                <StackPanel Grid.Column="4" x:Name="PanelSheetManageButtons" Orientation="Horizontal">
                                    <Button Content="➕ إضافة ورقة تقييم جديدة"
                                            Style="{StaticResource PrimaryButton}" Height="32" Padding="12,0" FontSize="12.5" Margin="0,0,8,0"
                                            Click="BtnAddNewSheetTab_Click"/>

                                    <Button Content="✏ تعديل اسم/فئة الورقة"
                                            Style="{StaticResource SecondaryButton}" Height="32" Padding="10,0" FontSize="12" Margin="0,0,8,0"
                                            Click="BtnRenameCurrentSheet_Click"/>

                                    <Button Content="🗑 حذف الورقة"
                                            Style="{StaticResource DangerButton}" Height="32" Padding="10,0" FontSize="12"
                                            Click="BtnDeleteCurrentSheet_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
