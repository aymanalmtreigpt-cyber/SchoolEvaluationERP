<UserControl x:Class="SchoolEvaluationERP.Views.FinalReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI">

    <Grid Margin="6">
        <Border Style="{StaticResource CardStyle}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 0: العنوان وأزرار التصدير -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="التقرير الشهري النهائي واحتساب الحوافز وتوليد القيد المحاسبي"
                                   FontSize="17.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="يحتسب النظام معدل التقييم الشهري بقسمة محصلة كل مقيم على عدد الأسابيع الفعلية المدخلة (حتى لو كانت 3 أسابيع)، ثم يطبق معادلة الحافز والتقريب لأقرب 50 ريالاً."
                                   FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>

                    <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnCalculateReport" Content="🔄 احتساب وتحديث التقرير"
                                Style="{StaticResource SecondaryButton}" Height="38" Padding="14,0" Margin="0,0,8,4"
                                Click="BtnCalculateReport_Click"/>

                        <Button x:Name="BtnExportExcel" Content="📗 تصدير القيد والتقرير (Excel)"
                                Style="{StaticResource PrimaryButton}" Height="38" Padding="16,0" Margin="0,0,8,4"
                                Click="BtnExportExcel_Click"/>

                        <Button x:Name="BtnExportPdf" Content="🖨 طباعة الكشف الرسمي A4 (PDF)"
                                Style="{StaticResource SecondaryButton}" Height="38" Padding="14,0" Margin="0,0,0,4"
                                Click="BtnExportPdf_Click"/>
                    </WrapPanel>
                </Grid>

                <!-- 1: إعدادات الفترة والفلاتر وإعدادات القيد المحاسبي -->
                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.75*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="السنة:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbYear" Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="Filter_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="الشهر:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbMonth" Style="{StaticResource ModernComboBox}"
                                          DisplayMemberPath="DisplayText" SelectedValuePath="MonthNumber"
                                          SelectionChanged="Filter_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="فلترة بالفرع:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbBranch" Style="{StaticResource ModernComboBox}"
                                          DisplayMemberPath="DisplayText" SelectedValuePath="Value"
                                          SelectionChanged="Filter_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="فلترة بالفئة:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbCategory" Style="{StaticResource ModernComboBox}"
                                          DisplayMemberPath="DisplayText" SelectedValuePath="Value"
                                          SelectionChanged="Filter_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="8">
                                <TextBlock Text="🔍 بحث باسم الموظف:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtSearchEmployee" Style="{StaticResource ModernTextBox}"
                                         ToolTip="ابحث بالاسم التقييمي أو الاسم في النظام..."
                                         TextChanged="TxtSearchEmployee_TextChanged"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.8*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="0.85*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="0.85*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="اسم الحساب المدين (في القيد المحاسبي):" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtDebitAccount" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="السقف الأعلى للحافز (100%):" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtMaxIncentive" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="أقل قيمة للحافز (> 80%):" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtMinIncentive" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <CheckBox Grid.Column="6" x:Name="ChkRoundTo50" Content="التقريب لأقرب 50 ريالاً"
                                      IsChecked="True" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,10"
                                      Checked="ChkOption_Changed" Unchecked="ChkOption_Changed"/>

                            <CheckBox Grid.Column="8" x:Name="ChkOnlyDeserving" Content="إظهار المستحقين للحافز فقط (> 0)"
                                      IsChecked="False" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,10"
                                      Checked="ChkOption_Changed" Unchecked="ChkOption_Changed"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 2: بطاقات الملخص الإحصائي والمالي السريع -->
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.25*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,8">
                        <StackPanel>
                            <TextBlock Text="إجمالي الموظفين المشمولين" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TxtKpiTotalEmployees" Text="0 موظف" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="14,8">
                        <StackPanel>
                            <TextBlock Text="عدد المستحقين للحافز (> 80%)" FontSize="12" Foreground="#047857"/>
                            <TextBlock x:Name="TxtKpiDeservingCount" Text="0 مستحق" FontSize="18" FontWeight="Bold" Foreground="#047857" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14,8">
                        <StackPanel>
                            <TextBlock Text="متوسط الأداء الشهري العام" FontSize="12" Foreground="#1E40AF"/>
                            <TextBlock x:Name="TxtKpiAverageScore" Text="0 %" FontSize="18" FontWeight="Bold" Foreground="#1E40AF" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="14,8">
                        <StackPanel>
                            <TextBlock Text="إجمالي الحوافز الشهرية المعتمدة للصرف" FontSize="12" Foreground="#92400E"/>
                            <TextBlock x:Name="TxtKpiTotalPayout" Text="0 ريال" FontSize="18" FontWeight="Bold" Foreground="#92400E" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3: التبويبان (القيد المحاسبي النهائي + تفصيل درجات الأسابيع والمقيمين) -->
                <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0" FontSize="13.5">

                    <!-- التبويب الأول: القيد المحاسبي المطابق لنموذج المدرسة -->
                    <TabItem Header="  💰 1. القيد المحاسبي النهائي للحوافز (نموذج المدرسة)  " Padding="14,6" FontWeight="Bold">
                        <DataGrid x:Name="GridAccountingJournal" Margin="0,8,0,0"
                                  IsReadOnly="True"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="م" Binding="{Binding RowNumber}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="45"/>
                                <DataGridTextColumn Header="مكان حساب الموظف" Binding="{Binding BranchName}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="115"/>
                                <DataGridTextColumn Header="الحساب المدين" Binding="{Binding DebitAccount}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="240"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding FinalAmountDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="95"/>
                                <DataGridTextColumn Header="الحساب الدائن (الاسم في النظام)" Binding="{Binding CreditAccountSystemName}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="250"/>
                                <DataGridTextColumn Header="البيان" Binding="{Binding StatementText}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="*"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding EntryDateFormatted}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="105"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- التبويب الثاني: تفصيل الأسابيع الأربعة وحصص المقيمين ومعدل التقييم -->
                    <TabItem Header="  📊 2. تفصيل درجات الأسابيع والمقيمين والنسب  " Padding="14,6" FontWeight="Bold">
                        <DataGrid x:Name="GridDetailedBreakdown" Margin="0,8,0,0"
                                  IsReadOnly="True"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="م" Binding="{Binding RowNumber}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="45"/>
                                <DataGridTextColumn Header="الاسم التقييمي للموظف" Binding="{Binding EvaluationName}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="185"/>
                                <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="85"/>
                                <DataGridTextColumn Header="الفئة" Binding="{Binding CategoryName}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="85"/>
                                <DataGridTextColumn Header="أسبوع 1" Binding="{Binding Week1Display}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="70"/>
                                <DataGridTextColumn Header="أسبوع 2" Binding="{Binding Week2Display}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="70"/>
                                <DataGridTextColumn Header="أسبوع 3" Binding="{Binding Week3Display}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="70"/>
                                <DataGridTextColumn Header="أسبوع 4" Binding="{Binding Week4Display}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="70"/>
                                <DataGridTextColumn Header="الأسابيع الفعلية" Binding="{Binding ActualWeeksCount}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="80"/>
                                <DataGridTextColumn Header="تفصيل متوسط كل مقيم من وزنه" Binding="{Binding EvaluatorsBreakdownSummary}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="*"/>
                                <DataGridTextColumn Header="معدل التقييم" Binding="{Binding MonthlyAverageDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="90"/>
                                <DataGridTextColumn Header="نسبة الحافز" Binding="{Binding IncentivePercentDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="85"/>
                                <DataGridTextColumn Header="مبلغ الحافز" Binding="{Binding FinalAmountDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="95"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
