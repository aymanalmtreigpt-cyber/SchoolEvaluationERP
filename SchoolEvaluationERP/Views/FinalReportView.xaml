<UserControl x:Class="SchoolEvaluationERP.Views.FinalReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI">

    <Grid Margin="4">
        <Border Style="{StaticResource CardStyle}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="190"/>
                </Grid.RowDefinitions>

                <!-- 0: العنوان في سطر مستقل وأزرار التصدير تحته في WrapPanel بعرض البطاقة الكامل -->
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="التقرير الشهري النهائي واحتساب الحوافز وتوليد القيد المحاسبي"
                               FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="يحتسب النظام معدل التقييم الشهري للموظفين المستمرين بناءً على متوسط درجات كل مجموعة مقيمين وفق وزنها المعتمد للفئة (100 درجة)، مع تطبيق الحد الأعلى والحد الأدنى للحافز المحددين لكل فئة في صفحة (أساسيات الحوافز)."
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,6"/>

                    <WrapPanel Orientation="Horizontal">
                        <Button x:Name="BtnCalculateReport" Content="🔄 احتساب وتحديث التقرير"
                                Style="{StaticResource SecondaryButton}" Height="35" Padding="14,0" Margin="0,0,8,4"
                                Click="BtnCalculateReport_Click"/>

                        <Button x:Name="BtnExportExcel" Content="📗 تصدير القيد والتقرير (Excel)"
                                Style="{StaticResource PrimaryButton}" Height="35" Padding="16,0" Margin="0,0,8,4"
                                Click="BtnExportExcel_Click"/>

                        <Button x:Name="BtnExportPdf" Content="🖨 طباعة الكشف الرسمي A4 (PDF)"
                                Style="{StaticResource SecondaryButton}" Height="35" Padding="14,0" Margin="0,0,0,4"
                                Click="BtnExportPdf_Click"/>
                    </WrapPanel>
                </StackPanel>

                <!-- 1: إعدادات الفترة والفلاتر وإعدادات القيد المحاسبي -->
                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                    <StackPanel>
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                            <StackPanel Width="105" Margin="0,2,8,4">
                                <TextBlock Text="السنة:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbYear" Style="{StaticResource ModernComboBox}" Height="34"
                                          SelectionChanged="Filter_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Width="140" Margin="0,2,8,4">
                                <TextBlock Text="الشهر:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbMonth" Style="{StaticResource ModernComboBox}" Height="34"
                                          DisplayMemberPath="DisplayText" SelectedValuePath="MonthNumber"
                                          SelectionChanged="Filter_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Width="140" Margin="0,2,8,4">
                                <TextBlock Text="فلترة بالفرع:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbBranch" Style="{StaticResource ModernComboBox}" Height="34"
                                          DisplayMemberPath="DisplayText" SelectedValuePath="Value"
                                          SelectionChanged="Filter_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Width="150" Margin="0,2,8,4">
                                <TextBlock Text="فلترة بالفئة:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbCategory" Style="{StaticResource ModernComboBox}" Height="34"
                                          DisplayMemberPath="DisplayText" SelectedValuePath="Value"
                                          SelectionChanged="Filter_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Width="220" Margin="0,2,0,4">
                                <TextBlock Text="🔍 بحث باسم الموظف:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtSearchEmployee" Style="{StaticResource ModernTextBox}" Height="34"
                                         ToolTip="ابحث بالاسم التقييمي أو الاسم في النظام..."
                                         TextChanged="TxtSearchEmployee_TextChanged"/>
                            </StackPanel>
                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <StackPanel Width="320" Margin="0,2,14,4">
                                <TextBlock Text="اسم الحساب المدين (في القيد المحاسبي):" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtDebitAccount" Style="{StaticResource ModernTextBox}" Height="34"/>
                            </StackPanel>

                            <CheckBox x:Name="ChkRoundTo50" Content="التقريب لأقرب 50 ريالاً"
                                      IsChecked="True" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,16,10"
                                      Checked="ChkOption_Changed" Unchecked="ChkOption_Changed"/>

                            <CheckBox x:Name="ChkOnlyDeserving" Content="إظهار المستحقين للحافز فقط (> 0)"
                                      IsChecked="False" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,10"
                                      Checked="ChkOption_Changed" Unchecked="ChkOption_Changed"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 2: بطاقات الملخص الإحصائي والمالي السريع -->
                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,6" MinWidth="165">
                        <StackPanel>
                            <TextBlock Text="إجمالي الموظفين المشمولين" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TxtKpiTotalEmployees" Text="0 موظف" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,6" MinWidth="185">
                        <StackPanel>
                            <TextBlock Text="عدد المستحقين للحافز (أعلى من 80%)" FontSize="11.5" Foreground="#047857"/>
                            <TextBlock x:Name="TxtKpiDeservingCount" Text="0 مستحق" FontSize="16.5" FontWeight="Bold" Foreground="#047857" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,6" MinWidth="165">
                        <StackPanel>
                            <TextBlock Text="متوسط الأداء الشهري العام" FontSize="11.5" Foreground="#1E40AF"/>
                            <TextBlock x:Name="TxtKpiAverageScore" Text="0 %" FontSize="16.5" FontWeight="Bold" Foreground="#1E40AF" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="14,6" Margin="0,0,0,6" MinWidth="220">
                        <StackPanel>
                            <TextBlock Text="إجمالي الحوافز الشهرية المعتمدة للصرف" FontSize="11.5" Foreground="#92400E"/>
                            <TextBlock x:Name="TxtKpiTotalPayout" Text="0 ريال" FontSize="16.5" FontWeight="Bold" Foreground="#92400E" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- 3: التبويبان (القيد المحاسبي النهائي + تفصيل درجات المقيمين) -->
                <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0" FontSize="13.5">

                    <!-- التبويب الأول: القيد المحاسبي المطابق لنموذج المدرسة -->
                    <TabItem Header="  💰 1. القيد المحاسبي النهائي للحوافز (نموذج المدرسة)  " Padding="14,6" FontWeight="Bold">
                        <DataGrid x:Name="GridAccountingJournal" Margin="0,6,0,0"
                                  IsReadOnly="True"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="م" Binding="{Binding RowNumber}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="50" MinWidth="45"/>
                                <DataGridTextColumn Header="مكان حساب الموظف" Binding="{Binding BranchName}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="120" MinWidth="110"/>
                                <DataGridTextColumn Header="الحساب المدين" Binding="{Binding DebitAccount}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="230" MinWidth="200"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding FinalAmountDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="95" MinWidth="85"/>
                                <DataGridTextColumn Header="الحساب الدائن (الاسم في النظام)" Binding="{Binding CreditAccountSystemName}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="240" MinWidth="210"/>
                                <DataGridTextColumn Header="البيان" Binding="{Binding StatementText}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="*" MinWidth="320"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding EntryDateFormatted}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="105" MinWidth="95"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- التبويب الثاني: تفصيل درجات المقيمين والأداء الشهري والنسب -->
                    <TabItem Header="  📊 2. تفصيل درجات المقيمين والأداء الشهري والنسب  " Padding="14,6" FontWeight="Bold">
                        <DataGrid x:Name="GridDetailedBreakdown" Margin="0,6,0,0"
                                  IsReadOnly="True"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="م" Binding="{Binding RowNumber}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="50" MinWidth="45"/>
                                <DataGridTextColumn Header="الاسم التقييمي للموظف" Binding="{Binding EvaluationName}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="185" MinWidth="165"/>
                                <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="90" MinWidth="80"/>
                                <DataGridTextColumn Header="الفئة" Binding="{Binding CategoryName}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="110" MinWidth="95"/>
                                <DataGridTextColumn Header="الوظيفة ونوعها" Binding="{Binding FullJobDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="145" MinWidth="130"/>
                                <DataGridTextColumn Header="حالة الحافز" Binding="{Binding HasIncentiveDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="115" MinWidth="105"/>
                                <DataGridTextColumn Header="حالة الاكتمال" Binding="{Binding CompletionStatusDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="100" MinWidth="90"/>
                                <DataGridTextColumn Header="تفصيل مجموعات المقيمين والأوزان" Binding="{Binding EvaluatorsBreakdownSummary}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="*" MinWidth="360"/>
                                <DataGridTextColumn Header="معدل الأداء" Binding="{Binding MonthlyAverageDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="90" MinWidth="85"/>
                                <DataGridTextColumn Header="نسبة الحافز" Binding="{Binding IncentivePercentDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="90" MinWidth="85"/>
                                <DataGridTextColumn Header="مبلغ الحافز" Binding="{Binding FinalAmountDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="95" MinWidth="85"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
