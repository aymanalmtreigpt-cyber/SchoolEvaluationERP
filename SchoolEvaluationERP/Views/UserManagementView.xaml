<UserControl x:Class="SchoolEvaluationERP.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI">

    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="1.35*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="حسابات مستخدمي النظام" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="اختر مستخدماً لعرض أو تعديل صلاحياته حسب صلاحياتك" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="BtnNewUser" Content="+ مستخدم جديد"
                            Style="{StaticResource PrimaryButton}" Height="36" Padding="14,0"
                            Click="BtnNewUser_Click"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <TextBox x:Name="TxtSearchUser" Style="{StaticResource ModernTextBox}"
                             ToolTip="ابحث باسم المستخدم أو اسم الموظف..."
                             TextChanged="TxtSearchUser_TextChanged"/>
                </Grid>

                <DataGrid Grid.Row="2" x:Name="GridUsers"
                          SelectionChanged="GridUsers_SelectionChanged"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم الدخول" Binding="{Binding Username}" Width="105"/>
                        <DataGridTextColumn Header="اسم الموظف" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding RoleDisplay}" Width="165"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding StatusDisplay}" Width="65"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TxtFormTitle" Text="إنشاء حساب مستخدم جديد" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TxtFormSubtitle" Text="حدد بيانات الدخول ثم خصص صلاحيات (القراءة، الكتابة، التعديل، الحذف) لكل شاشة" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="BtnCopyPerms" Content="📋 نسخ الصلاحيات"
                                Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" FontSize="12" Margin="0,0,8,0"
                                ToolTip="نسخ مصفوفة الصلاحيات من الموظف الحالي"
                                Click="BtnCopyPerms_Click"/>

                        <Button x:Name="BtnPastePerms" Content="📥 لصق الصلاحيات"
                                Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" FontSize="12"
                                IsEnabled="False"
                                ToolTip="لصق الصلاحيات المنسوخة على هذا الموظف"
                                Click="BtnPastePerms_Click"/>
                    </StackPanel>
                </Grid>

                <Border x:Name="FormInputsContainer" Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="اسم المستخدم (للدخول)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtEditUsername" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="الاسم الكامل للموظف" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtEditFullName" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock x:Name="LblPasswordField" Text="كلمة المرور الابتدائية (تُسلم للموظف)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtEditPlainPassword" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkIsAdmin" Content="منح صلاحية مدير النظام الشاملة (Admin)"
                                      FontWeight="SemiBold" Margin="0,0,0,6"
                                      Checked="ChkIsAdmin_Changed" Unchecked="ChkIsAdmin_Changed"/>

                            <CheckBox x:Name="ChkMustChangePwd" Content="إجباره على تغيير كلمة السر عند الدخول" IsChecked="True" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkIsActive" Content="الحساب نشط ومسموح له بالدخول" IsChecked="True"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="مصفوفة صلاحيات العمليات (قراءة / إضافة / تعديل / حذف)" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="BtnSelectAllPerms" Content="تحديد الكل" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" FontSize="12" Click="BtnSelectAllPerms_Click"/>
                        <Button Grid.Column="3" x:Name="BtnClearAllPerms" Content="إلغاء الكل" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" FontSize="12" Click="BtnClearAllPerms_Click"/>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="GridPermissions" CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="القسم / شاشة النظام" Binding="{Binding ModuleArabicName}" IsReadOnly="True" Width="*"/>
                            <DataGridCheckBoxColumn Header="قراءة وعرض" Binding="{Binding CanRead, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                            <DataGridCheckBoxColumn Header="إضافة وكتابة" Binding="{Binding CanInsert, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                            <DataGridCheckBoxColumn Header="تعديل" Binding="{Binding CanUpdate, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                            <DataGridCheckBoxColumn Header="حذف" Binding="{Binding CanDelete, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnSaveUser" Content="💾 حفظ بيانات الحساب والصلاحيات"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnSaveUser_Click"/>

                    <Button Grid.Column="2" x:Name="BtnDeleteUser" Content="🗑 حذف الحساب"
                            Style="{StaticResource DangerButton}" Visibility="Collapsed"
                            Click="BtnDeleteUser_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
