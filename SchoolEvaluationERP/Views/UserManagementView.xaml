<UserControl x:Class="SchoolEvaluationERP.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI">

    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" MinWidth="260"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1.4*" MinWidth="320"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="160"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,12,4">
                            <TextBlock Text="حسابات مستخدمي النظام" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="اختر مستخدماً لعرض أو تعديل صلاحياته" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <Button x:Name="BtnNewUser" Content="+ مستخدم جديد"
                                Style="{StaticResource PrimaryButton}" Height="34" Padding="12,0" Margin="0,2,0,4"
                                Click="BtnNewUser_Click"/>
                    </WrapPanel>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <TextBox x:Name="TxtSearchUser" Style="{StaticResource ModernTextBox}" Height="35"
                             ToolTip="ابحث باسم المستخدم أو اسم الموظف..."
                             TextChanged="TxtSearchUser_TextChanged"/>
                </Grid>

                <DataGrid Grid.Row="2" x:Name="GridUsers"
                          SelectionChanged="GridUsers_SelectionChanged"
                          IsReadOnly="True"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم الدخول" Binding="{Binding Username}" Width="105" MinWidth="95"/>
                        <DataGridTextColumn Header="اسم الموظف" Binding="{Binding FullName}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="*" MinWidth="160"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding RoleDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="165" MinWidth="145"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding StatusDisplay}" Width="70" MinWidth="65"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Style="{StaticResource VerticalGridSplitterStyle}" ToolTip="اسحب لتغيير عرض قائمة المستخدمين ونموذج الصلاحيات"/>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="160"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock x:Name="TxtFormTitle" Text="إنشاء حساب مستخدم جديد" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtFormSubtitle" Text="حدد بيانات الدخول ثم خصص صلاحيات (القراءة، الكتابة، التعديل، الحذف) لكل شاشة" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,6"/>

                    <WrapPanel Orientation="Horizontal">
                        <Button x:Name="BtnCopyPerms" Content="📋 نسخ الصلاحيات"
                                Style="{StaticResource SecondaryButton}" Height="32" Padding="10,0" FontSize="12" Margin="0,0,6,4"
                                ToolTip="نسخ مصفوفة الصلاحيات من الموظف الحالي"
                                Click="BtnCopyPerms_Click"/>

                        <Button x:Name="BtnPastePerms" Content="📥 لصق الصلاحيات"
                                Style="{StaticResource SecondaryButton}" Height="32" Padding="10,0" FontSize="12" Margin="0,0,0,4"
                                IsEnabled="False"
                                ToolTip="لصق الصلاحيات المنسوخة على هذا الموظف"
                                Click="BtnPastePerms_Click"/>
                    </WrapPanel>
                </StackPanel>

                <Border x:Name="FormInputsContainer" Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Width="185" Margin="0,2,12,6">
                            <TextBlock Text="اسم المستخدم (للدخول)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtEditUsername" Style="{StaticResource ModernTextBox}" Height="34"/>
                        </StackPanel>

                        <StackPanel Width="210" Margin="0,2,12,6">
                            <TextBlock Text="الاسم الكامل للموظف" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtEditFullName" Style="{StaticResource ModernTextBox}" Height="34"/>
                        </StackPanel>

                        <StackPanel Width="185" Margin="0,2,12,6">
                            <TextBlock x:Name="LblPasswordField" Text="كلمة المرور الابتدائية" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtEditPlainPassword" Style="{StaticResource ModernTextBox}" Height="34"/>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center" Margin="0,4,0,4">
                            <CheckBox x:Name="ChkIsAdmin" Content="منح صلاحية مدير النظام الشاملة (Admin)"
                                      FontWeight="SemiBold" Margin="0,0,0,4"
                                      Checked="ChkIsAdmin_Changed" Unchecked="ChkIsAdmin_Changed"/>

                            <CheckBox x:Name="ChkMustChangePwd" Content="إجباره على تغيير كلمة السر عند الدخول" IsChecked="True" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ChkIsActive" Content="الحساب نشط ومسموح له بالدخول" IsChecked="True"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="مصفوفة صلاحيات العمليات (قراءة / إضافة / تعديل / حذف)" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,4"/>
                        <Button x:Name="BtnSelectAllPerms" Content="تحديد الكل" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" FontSize="12" Margin="0,0,6,4" Click="BtnSelectAllPerms_Click"/>
                        <Button x:Name="BtnClearAllPerms" Content="إلغاء الكل" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" FontSize="12" Margin="0,0,0,4" Click="BtnClearAllPerms_Click"/>
                    </WrapPanel>

                    <DataGrid Grid.Row="1" x:Name="GridPermissions"
                              CanUserSortColumns="False"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseLeftButtonDown="GridPermissions_PreviewMouseLeftButtonDown">
                        <DataGrid.Resources>
                            <Style x:Key="ClickablePermCellStyle" TargetType="DataGridCell">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="القسم / شاشة النظام" Binding="{Binding ModuleArabicName}" ElementStyle="{StaticResource WrappingCellTextStyle}" IsReadOnly="True" Width="*" MinWidth="210"/>

                            <DataGridTemplateColumn x:Name="ColPermRead" Header="قراءة وعرض" IsReadOnly="True" Width="90" MinWidth="85" CellStyle="{StaticResource ClickablePermCellStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <CheckBox IsChecked="{Binding CanRead, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn x:Name="ColPermInsert" Header="إضافة وكتابة" IsReadOnly="True" Width="100" MinWidth="90" CellStyle="{StaticResource ClickablePermCellStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <CheckBox IsChecked="{Binding CanInsert, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn x:Name="ColPermUpdate" Header="تعديل" IsReadOnly="True" Width="75" MinWidth="70" CellStyle="{StaticResource ClickablePermCellStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <CheckBox IsChecked="{Binding CanUpdate, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn x:Name="ColPermDelete" Header="حذف" IsReadOnly="True" Width="75" MinWidth="70" CellStyle="{StaticResource ClickablePermCellStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <CheckBox IsChecked="{Binding CanDelete, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnSaveUser" Content="💾 حفظ بيانات الحساب والصلاحيات"
                            Style="{StaticResource PrimaryButton}" Height="36"
                            Click="BtnSaveUser_Click"/>

                    <Button Grid.Column="2" x:Name="BtnDeleteUser" Content="🗑 حذف الحساب"
                            Style="{StaticResource DangerButton}" Height="36" Visibility="Collapsed"
                            Click="BtnDeleteUser_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

