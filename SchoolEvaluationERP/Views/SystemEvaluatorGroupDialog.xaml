<Window x:Class="SchoolEvaluationERP.Views.SystemEvaluatorGroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات مجموعة التقييم الافتراضية (الغياب / التأخير)"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBgBrush}"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Border Style="{StaticResource CardStyle}" Padding="20">
            <StackPanel>
                <TextBlock x:Name="TxtDialogTitle"
                           Text="إعدادات مجموعة الغياب الافتراضية"
                           FontSize="17.5" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>

                <TextBlock x:Name="TxtDialogSubtitle"
                           Text="مجموعة نظام افتراضية ثابتة. حدد الحد الأقصى المسموح به، ثم خصص الفئات ودرجة كل فئة من زر (تخصيص المقيمين ودرجات التقييم للفئات) ليتم توليد القالب تلقائياً."
                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,16"/>

                <TextBlock Text="اسم مجموعة التقييم (ثابت لا يمكن تعديله):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtGroupNameReadOnly"
                         Style="{StaticResource ModernTextBox}"
                         IsReadOnly="True"
                         Background="#E2E8F0"
                         FontWeight="Bold"
                         Margin="0,0,0,14"/>

                <TextBlock x:Name="LblMaxAllowedCount"
                           Text="عدد أيام الغياب المسموح بها في الشهر (ما زاد عن هذا الحد تصبح درجته صفراً):"
                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>

                <TextBox x:Name="TxtMaxAllowedCount"
                         Style="{StaticResource ModernTextBox}"
                         FontWeight="Bold" FontSize="15"
                         TextAlignment="Center"
                         TextChanged="TxtMaxAllowedCount_TextChanged"
                         Margin="0,0,0,12"/>

                <!-- معاينة حية لجدول الخصم التدريجي المتساوي -->
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="📊 معاينة احتساب الدرجة تلقائياً (الخصم التدريجي المتساوي):"
                                   FontWeight="Bold" FontSize="12.5" Foreground="#1E3A8A" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtFormulaPreview"
                                   Text="• 0 = 100%  |  • 1 = 75%  |  • 2 = 50%  |  • 3 = 25%  |  • أكثر من 3 = 0% (صفر)"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="#1E40AF" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnSaveSettings"
                            Content="💾 حفظ الإعدادات وتحديث القالب التلقائي"
                            Style="{StaticResource PrimaryButton}" Height="40"
                            Click="BtnSaveSettings_Click"/>

                    <Button Grid.Column="2" Content="إلغاء"
                            Style="{StaticResource SecondaryButton}" Height="40"
                            IsCancel="True"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
