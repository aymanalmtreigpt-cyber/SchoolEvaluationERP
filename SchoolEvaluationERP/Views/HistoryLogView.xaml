<UserControl x:Class="SchoolEvaluationERP.Views.HistoryLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI">

    <Grid Margin="4">
        <TabControl x:Name="MainHistoryTabControl" Background="Transparent" BorderThickness="0" FontSize="14">

            <!-- التبويب الأول: 1. سجل التقييمات والأرشيف -->
            <TabItem Header="  🕒 1. سجل التقييمات والأرشيف  " Padding="14,8" FontWeight="Bold">
                <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- شريط العنوان وأزرار التحكم بالسجل -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="سجل التقييمات الأسبوعية والأرشيف التاريخي"
                                           FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="اضغط مرتين على أي تقييم (أو اضغط عرض الدرجات) لفتحه في وضع القراءة فقط، وللتعديل حدد السجل واضغط (✏ فتح وتعديل التقييم). يمكنك تحديد عدة سجلات بالماوس أو Ctrl أو Shift."
                                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>

                            <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="BtnViewSelectedRecord" Content="👁 عرض التقييم (قراءة فقط)"
                                        Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,8,6"
                                        Click="BtnViewSelectedRecord_Click"/>

                                <Button x:Name="BtnEditSelectedRecord" Content="✏ فتح وتعديل التقييم"
                                        Style="{StaticResource PrimaryButton}" Height="38" Margin="0,0,8,6"
                                        Click="BtnEditSelectedRecord_Click"/>

                                <Button x:Name="BtnDeleteSelectedRecords" Content="🗑 حذف المحدد"
                                        Style="{StaticResource DangerButton}" Height="38" Padding="14,0" Margin="0,0,0,6"
                                        Click="BtnDeleteSelectedRecords_Click"/>
                            </WrapPanel>
                        </Grid>

                        <!-- شريط البحث والفلترة المتقدمة (المقيم / السنة / الشهر / الأسبوع) -->
                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="0.85*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="0.95*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🔍 بحث باسم المقيم:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtSearchEvaluator" Style="{StaticResource ModernTextBox}"
                                             ToolTip="اكتب اسم المقيم لفلترة السجل..."
                                             TextChanged="FilterControl_Changed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="السنة:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbFilterYear" Style="{StaticResource ModernComboBox}"
                                              DisplayMemberPath="DisplayText" SelectedValuePath="Value"
                                              SelectionChanged="FilterCombo_SelectionChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="الشهر:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbFilterMonth" Style="{StaticResource ModernComboBox}"
                                              DisplayMemberPath="DisplayText" SelectedValuePath="Value"
                                              SelectionChanged="FilterCombo_SelectionChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="الأسبوع:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbFilterWeek" Style="{StaticResource ModernComboBox}"
                                              DisplayMemberPath="DisplayText" SelectedValuePath="Value"
                                              SelectionChanged="FilterCombo_SelectionChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="8" VerticalAlignment="Bottom">
                                    <Button Content="عرض الكل" Style="{StaticResource SecondaryButton}" Height="38" Padding="14,0"
                                            Click="BtnResetFilters_Click"/>
                                </StackPanel>

                                <StackPanel Grid.Column="10" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtRecordsCountBadge" Text="إجمالي السجلات: 0"
                                               FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- جدول سجل التقييمات المحفوظة -->
                        <DataGrid Grid.Row="2" x:Name="GridHistoryRecords"
                                  IsReadOnly="True"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  SelectionChanged="GridHistoryRecords_SelectionChanged"
                                  MouseDoubleClick="GridHistoryRecords_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم السجل" Binding="{Binding RecordID}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="80"/>
                                <DataGridTextColumn Header="اسم المقيم المسؤول" Binding="{Binding EvaluatorName}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="175"/>
                                <DataGridTextColumn Header="الفترة (الشهر والأسبوع)" Binding="{Binding PeriodDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="195"/>
                                <DataGridTextColumn Header="نسخة القالب" Binding="{Binding VersionDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="85"/>
                                <DataGridTextColumn Header="عدد الموظفين" Binding="{Binding EvaluatedEmployeesCount}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="95"/>
                                <DataGridTextColumn Header="متوسط التقييم" Binding="{Binding AverageScoreDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="105"/>
                                <DataGridTextColumn Header="أُدخل بواسطة" Binding="{Binding CreatedByFullName}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="*"/>
                                <DataGridTextColumn Header="تاريخ الإدخال" Binding="{Binding CreatedAtDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="145"/>
                                <DataGridTemplateColumn Header="معاينة القراءة" Width="115">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="👁 عرض الدرجات"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Height="30" Padding="8,0" FontSize="12"
                                                    ToolTip="فتح درجات هذا التقييم في وضع القراءة فقط"
                                                    Click="BtnRowViewReadOnly_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- التبويب الثاني: 2. استعراض وتعديل درجات التقييم -->
            <TabItem x:Name="TabRecordDetails" Header="  📋 2. استعراض وتعديل درجات التقييم  " Padding="14,8" FontWeight="Bold">
                <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 0: الشريط العلوي لتفاصيل السجل (مقسم لسطرين واسعين وبدون مربع الورقة النشطة) -->
                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtDetailsHeaderTitle"
                                                   Text="لم يتم اختيار سجل تقييم بعد — اختر تقييماً من تبويب (1. سجل التقييمات والأرشيف)"
                                                   FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>

                                        <Border x:Name="BadgeDetailsMode" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="6" Padding="12,4" VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock x:Name="TxtBadgeDetailsMode" Text="🔒 وضع القراءة فقط" Foreground="#92400E" FontWeight="Bold" FontSize="12.5"/>
                                        </Border>
                                    </WrapPanel>

                                    <TextBlock x:Name="TxtDetailsSubInfo"
                                               Text="يعرض هذا القسم الدرجات التاريخية المحفوظة للموظفين وفق نسخة القالب ووزن المقيم المعتمدين وقت التقييم."
                                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>

                                <WrapPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnUnlockEditInDetails" Content="✏ تفعيل التعديل"
                                            Style="{StaticResource SecondaryButton}" Height="36" Padding="12,0" Margin="0,0,8,4"
                                            Visibility="Collapsed"
                                            Click="BtnUnlockEditInDetails_Click"/>

                                    <Button x:Name="BtnDetailFillAll" Content="⚡ الدرجة الكاملة للورقة (100)"
                                            Style="{StaticResource SecondaryButton}" Height="36" Padding="12,0" Margin="0,0,8,4"
                                            IsEnabled="False"
                                            Click="BtnDetailFillAll_Click"/>

                                    <Button x:Name="BtnDetailFillSelected" Content="✔ الدرجة الكاملة للمحددين"
                                            Style="{StaticResource SecondaryButton}" Height="36" Padding="12,0" Margin="0,0,8,4"
                                            IsEnabled="False"
                                            Click="BtnDetailFillSelected_Click"/>

                                    <Button x:Name="BtnDetailSaveChanges" Content="💾 حفظ التعديلات المعتمدة"
                                            Style="{StaticResource PrimaryButton}" Height="38" Padding="16,0" Margin="0,0,0,4"
                                            IsEnabled="False"
                                            Click="BtnDetailSaveChanges_Click"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- 1: شريط البحث السريع عن موظف داخل الورقة المفتوحة -->
                        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="🔍 فلترة الموظفين داخل الورقة:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="2" x:Name="TxtFilterSheetEmployee" Style="{StaticResource ModernTextBox}" Height="34"
                                         ToolTip="اكتب اسم الموظف أو الفرع للبحث داخل هذه الورقة..."
                                         TextChanged="TxtFilterSheetEmployee_TextChanged"/>
                                <Button Grid.Column="4" Content="إظهار كل موظفي الورقة" Style="{StaticResource SecondaryButton}" Height="34" Padding="10,0" FontSize="12"
                                        Click="BtnClearSheetEmployeeFilter_Click"/>
                                <TextBlock Grid.Column="6" x:Name="TxtDetailEmployeesCount" Text="عدد الموظفين: 0" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 2: جدول درجات التقييم المفتوح -->
                        <DataGrid Grid.Row="2" x:Name="GridRecordSheetScores"
                                  CanUserSortColumns="False"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  BeginningEdit="GridRecordSheetScores_BeginningEdit"
                                  CellEditEnding="GridRecordSheetScores_CellEditEnding"/>

                        <!-- 3: الشريط السفلي لأوراق التقييم المحفوظ (بلون أزرق ثلجي فاتح ومريح للعين) -->
                        <Border Grid.Row="3" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.5" CornerRadius="8" Padding="12,8" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="📑 أوراق التقييم:" Foreground="#1E3A8A" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0"/>

                                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="StackDetailSheetTabs" Orientation="Horizontal" VerticalAlignment="Center"/>
                                </ScrollViewer>

                                <TextBlock Grid.Column="4" x:Name="TxtDetailSheetAverageBadge"
                                           Text="متوسط درجات الورقة: 0 / 100"
                                           Foreground="#1E40AF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="8,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

