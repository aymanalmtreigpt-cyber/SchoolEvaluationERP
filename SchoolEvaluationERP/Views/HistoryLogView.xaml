<UserControl x:Class="SchoolEvaluationERP.Views.HistoryLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI">

    <Grid Margin="4">
        <TabControl x:Name="MainHistoryTabControl" Background="Transparent" BorderThickness="0" FontSize="14">

            <!-- التبويب الأول: 1. سجل التقييمات الشهرية والأرشيف (للمراقبة والقراءة فقط) -->
            <TabItem Header="  🕒 1. سجل التقييمات الشهرية والأرشيف (للمراقبة فقط)  " Padding="14,8" FontWeight="Bold">
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="180"/>
                        </Grid.RowDefinitions>

                        <!-- 0: العنوان وتنبيه السجل الرقابي المحمي -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="سجل التقييمات الشهرية والأرشيف التاريخي (سجل رقابي محمي للقراءة فقط)"
                                           FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,4"/>

                                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="10,3" VerticalAlignment="Center" Margin="0,0,0,4">
                                    <TextBlock Text="🛡️ أرشيف رقابي دائم — لا يُحذف ولا يتأثر بحذف القوالب أو الموظفين" Foreground="#047857" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"/>
                                </Border>
                            </WrapPanel>

                            <TextBlock Text="يحتفظ هذا السجل بجميع التقييمات الشهرية المعتمدة للمراقبة والمراجعة فقط. (لتعديل تقييم شهر نشط قبل حذف قالبه أو موظفيه، انتقل إلى شاشة 4. إدخال التقييمات الشهرية)."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,6"/>

                            <WrapPanel Orientation="Horizontal">
                                <Button x:Name="BtnViewSelectedRecord" Content="👁 عرض تفاصيل ودرجات التقييم المحدد (قراءة فقط)"
                                        Style="{StaticResource PrimaryButton}" Height="35" Padding="16,0" Margin="0,0,8,4"
                                        Click="BtnViewSelectedRecord_Click"/>
                            </WrapPanel>
                        </StackPanel>

                        <!-- 1: شريط البحث والفلترة المرن عبر WrapPanel -->
                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <StackPanel Width="230" Margin="0,2,10,4">
                                    <TextBlock Text="🔍 بحث باسم المقيم أو المجموعة:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtSearchEvaluator" Style="{StaticResource ModernTextBox}" Height="34"
                                             ToolTip="اكتب اسم المقيم أو مجموعته لفلترة السجل..."
                                             TextChanged="FilterControl_Changed"/>
                                </StackPanel>

                                <StackPanel Width="130" Margin="0,2,10,4">
                                    <TextBlock Text="السنة:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CmbFilterYear" Style="{StaticResource ModernComboBox}" Height="34"
                                              DisplayMemberPath="DisplayText" SelectedValuePath="Value"
                                              SelectionChanged="FilterCombo_SelectionChanged"/>
                                </StackPanel>

                                <StackPanel Width="155" Margin="0,2,10,4">
                                    <TextBlock Text="الشهر:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CmbFilterMonth" Style="{StaticResource ModernComboBox}" Height="34"
                                              DisplayMemberPath="DisplayText" SelectedValuePath="Value"
                                              SelectionChanged="FilterCombo_SelectionChanged"/>
                                </StackPanel>

                                <Button Content="عرض الكل" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0" VerticalAlignment="Bottom" Margin="0,2,12,4"
                                        Click="BtnResetFilters_Click"/>

                                <TextBlock x:Name="TxtRecordsCountBadge" Text="إجمالي السجلات المحفوظة: 0"
                                           FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                            </WrapPanel>
                        </Border>

                        <!-- 2: جدول سجل التقييمات الشهرية المحفوظة -->
                        <DataGrid Grid.Row="2" x:Name="GridHistoryRecords"
                                  IsReadOnly="True"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  SelectionChanged="GridHistoryRecords_SelectionChanged"
                                  MouseDoubleClick="GridHistoryRecords_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم السجل" Binding="{Binding RecordID}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="80" MinWidth="75"/>
                                <DataGridTextColumn Header="المقيم المسؤول والمجموعة" Binding="{Binding EvaluatorWithGroupDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="220" MinWidth="190"/>
                                <DataGridTextColumn Header="شهر التقييم" Binding="{Binding PeriodDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="145" MinWidth="135"/>
                                <DataGridTextColumn Header="نسخة القالب" Binding="{Binding VersionDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="85" MinWidth="80"/>
                                <DataGridTextColumn Header="عدد الموظفين" Binding="{Binding EvaluatedEmployeesCount}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="95" MinWidth="90"/>
                                <DataGridTextColumn Header="متوسط التقييم" Binding="{Binding AverageScoreDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="105" MinWidth="95"/>
                                <DataGridTextColumn Header="أُدخل بواسطة" Binding="{Binding CreatedByFullName}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="*" MinWidth="180"/>
                                <DataGridTextColumn Header="تاريخ الإدخال" Binding="{Binding CreatedAtDisplay}" ElementStyle="{StaticResource WrappingCellTextStyle}" Width="150" MinWidth="140"/>
                                <DataGridTemplateColumn Header="معاينة القراءة" Width="120" MinWidth="115">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="👁 عرض الدرجات"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Height="30" Padding="8,0" FontSize="12"
                                                    ToolTip="استعراض درجات هذا التقييم الشهري في وضع القراءة والمراقبة"
                                                    Click="BtnRowViewReadOnly_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- التبويب الثاني: 2. استعراض درجات التقييم الشهري (للقراءة والمراقبة فقط) -->
            <TabItem x:Name="TabRecordDetails" Header="  📋 2. استعراض درجات التقييم الشهري (قراءة فقط)  " Padding="14,8" FontWeight="Bold">
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="180"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 0: الشريط العلوي لتفاصيل السجل (للقراءة فقط) -->
                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtDetailsHeaderTitle"
                                               Text="لم يتم اختيار سجل تقييم بعد — اختر تقييماً شهرياً من تبويب (1. سجل التقييمات الشهرية والأرشيف)"
                                               FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,4"/>

                                    <Border x:Name="BadgeDetailsMode" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="6" Padding="10,3" VerticalAlignment="Center" Margin="0,0,0,4" Visibility="Collapsed">
                                        <TextBlock x:Name="TxtBadgeDetailsMode" Text="🔒 سجل رقابي ثابت — وضع القراءة والمراقبة فقط" Foreground="#92400E" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"/>
                                    </Border>
                                </WrapPanel>

                                <TextBlock x:Name="TxtDetailsSubInfo"
                                           Text="يعرض هذا القسم اللقطة التاريخية الكاملة لدرجات الموظفين ومبادئ التقييم وحصة المقيم المعتمدة وقت التقييم."
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 1: شريط البحث السريع عن موظف داخل الورقة المفتوحة -->
                        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔍 فلترة الموظفين داخل الورقة:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,2,8,4"/>
                                <TextBox x:Name="TxtFilterSheetEmployee" Style="{StaticResource ModernTextBox}" Width="240" Height="34" Margin="0,2,8,4"
                                         ToolTip="اكتب اسم الموظف أو الفرع أو الوظيفة للبحث داخل هذه الورقة..."
                                         TextChanged="TxtFilterSheetEmployee_TextChanged"/>
                                <Button Content="إظهار كل موظفي الورقة" Style="{StaticResource SecondaryButton}" Height="34" Padding="10,0" FontSize="12" Margin="0,2,14,4"
                                        Click="BtnClearSheetEmployeeFilter_Click"/>
                                <TextBlock x:Name="TxtDetailEmployeesCount" Text="عدد الموظفين: 0" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,2,0,4"/>
                            </WrapPanel>
                        </Border>

                        <!-- 2: جدول درجات التقييم المفتوح (للقراءة فقط) -->
                        <DataGrid Grid.Row="2" x:Name="GridRecordSheetScores"
                                  IsReadOnly="True"
                                  CanUserSortColumns="False"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"/>

                        <!-- 3: الشريط السفلي لأوراق التقييم المحفوظ -->
                        <Border Grid.Row="3" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.5" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="📑 أوراق التقييم:" Foreground="#1E3A8A" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0"/>

                                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="StackDetailSheetTabs" Orientation="Horizontal" VerticalAlignment="Center"/>
                                </ScrollViewer>

                                <TextBlock Grid.Column="4" x:Name="TxtDetailSheetAverageBadge"
                                           Text="متوسط درجات الورقة: 0 / 100"
                                           Foreground="#1E40AF" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" Margin="6,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
