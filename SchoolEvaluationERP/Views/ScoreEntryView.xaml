<UserControl x:Class="SchoolEvaluationERP.Views.ScoreEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI">

    <Grid Margin="4">
        <Border Style="{StaticResource CardStyle}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="95"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 0: شريط اختيار القالب والفترة الشهرية + أزرار اتجاه الانتقال التلقائي (مرن بالكامل) -->
                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                    <StackPanel>
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,14,4" VerticalAlignment="Center">
                                <TextBlock Text="إدخال التقييمات الشهرية للموظفين (مرة واحدة في الشهر — درجات صحيحة بدون كسور)"
                                           FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="اختر قالب المقيم وحدد السنة والشهر. يدعم الجدول الانتقال التلقائي السريع أفقياً أو رأسياً بمجرد كتابة الدرجة."
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="8,5" VerticalAlignment="Center" Margin="0,2,0,4">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="اتجاه الانتقال التلقائي:" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,8,0"/>

                                    <Button x:Name="BtnNavHorizontal" Content="⬅ الانتقال الأفقي"
                                            Style="{StaticResource PrimaryButton}" Height="30" Padding="10,0" FontSize="12" Margin="0,0,6,0"
                                            ToolTip="الانتقال التلقائي إلى الخلية المجاورة أفقياً في نفس صف الموظف"
                                            Click="BtnNavHorizontal_Click"/>

                                    <Button x:Name="BtnNavVertical" Content="⬇ الانتقال الرأسي"
                                            Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" FontSize="12"
                                            ToolTip="الانتقال التلقائي إلى الموظف التالي أسفل نفس العمود رأسياً"
                                            Click="BtnNavVertical_Click"/>
                                </WrapPanel>
                            </Border>
                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <StackPanel Width="250" Margin="0,2,10,4">
                                <TextBlock Text="1. المقيم / قالب التقييم:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbTemplate" Style="{StaticResource ModernComboBox}" Height="35"
                                          IsEditable="True" StaysOpenOnEdit="True"
                                          DisplayMemberPath="EvaluatorWithGroupDisplay" SelectedValuePath="TemplateID"
                                          SelectionChanged="CmbTemplate_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Width="115" Margin="0,2,10,4">
                                <TextBlock Text="2. السنة:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbYear" Style="{StaticResource ModernComboBox}" Height="35"
                                          SelectionChanged="PeriodFilter_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Width="155" Margin="0,2,10,4">
                                <TextBlock Text="3. الشهر:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbMonth" Style="{StaticResource ModernComboBox}" Height="35"
                                          DisplayMemberPath="DisplayText" SelectedValuePath="MonthNumber"
                                          SelectionChanged="PeriodFilter_SelectionChanged"/>
                            </StackPanel>

                            <Button x:Name="BtnReloadWorkspace" Content="🔄 تحديث الاستمارة"
                                    Style="{StaticResource SecondaryButton}" Height="35" Padding="14,0" VerticalAlignment="Bottom" Margin="0,2,0,4"
                                    Click="BtnReloadWorkspace_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 1: شريط حالة الاستمارة الشهرية وأزرار التعبئة السريعة واستيراد Excel والحفظ -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                    <StackPanel>
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock x:Name="TxtWorkspaceHeader"
                                       Text="يرجى اختيار قالب المقيم لبدء إدخال الدرجات الشهرية"
                                       FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,4"/>

                            <Border x:Name="BadgeMonthStatus" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="10,3" VerticalAlignment="Center" Margin="0,0,8,4" Visibility="Collapsed">
                                <TextBlock x:Name="TxtBadgeMonthStatus" Text="شهر جديد متاح للإدخال" Foreground="#047857" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"/>
                            </Border>

                            <Button x:Name="BtnMissingScoresAlert"
                                    Content="⚠ لم يتم إدخال تقييم لـ (0) موظف — اضغط للانتقال للموظف ⬇"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="29" Padding="12,0" FontSize="12" FontWeight="Bold"
                                    Background="#FEF2F2" BorderBrush="#EF4444" Foreground="#B91C1C"
                                    VerticalAlignment="Center" Margin="0,0,0,4"
                                    ToolTip="اضغط للانتقال مباشرة إلى الموظف التالي الذي لم يتم إدخال تقييمه في أي ورقة من أوراق القالب"
                                    Visibility="Collapsed"
                                    Click="BtnMissingScoresAlert_Click"/>
                        </WrapPanel>

                        <TextBlock x:Name="TxtWorkspaceHint"
                                   Text="💡 تلميح الإدخال السريع: بمجرد كتابة الدرجة ينتقل المؤشر تلقائياً للخلية التالية حسب الاتجاه المحدد."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnUnlockSavedMonthEdit" Content="✏ تفعيل تعديل تقييم هذا الشهر"
                                    Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" Margin="0,0,8,4"
                                    Visibility="Collapsed"
                                    Click="BtnUnlockSavedMonthEdit_Click"/>

                            <Button x:Name="BtnSyncTemplateEmployees" Content="🔄 مزامنة الموظفين مع القالب"
                                    Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" Margin="0,0,8,4"
                                    Background="#EEF2FF" BorderBrush="#6366F1" Foreground="#3730A3" FontWeight="Bold"
                                    ToolTip="مقارنة جميع أوراق هذا الشهر مع أحدث نسخة من القالب لإضافة الموظفين الجدد أو إزالة من أُزيلوا من القالب"
                                    Visibility="Collapsed"
                                    Click="BtnSyncTemplateEmployees_Click"/>

                            <Button x:Name="BtnImportBulkMultiMonthExcel" Content="📦 سحب التقييمات المجمعة (أشهر 7-10 لكل المقيمين)"
                                    Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" Margin="0,0,8,4"
                                    Background="#FEF3C7" BorderBrush="#F59E0B" Foreground="#92400E" FontWeight="Bold"
                                    ToolTip="سحب درجات عدة أشهر (مثلاً 7 و 8 و 9 و 10) لجميع المقيمين والموظفين دفعة واحدة من ملف الإكسل المجمع"
                                    Click="BtnImportBulkMultiMonthExcel_Click"/>

                            <Button x:Name="BtnImportScoresExcel" Content="📥 استيراد الدرجات من Excel"
                                    Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" Margin="0,0,8,4"
                                    ToolTip="رفع ملف القالب المعبأ بالإكسل لتفريغ الدرجات تلقائياً في الجدول"
                                    Click="BtnImportScoresExcel_Click"/>

                            <Button x:Name="BtnFillFullMarksAll" Content="⚡ الدرجة الكاملة للورقة (100)"
                                    Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" Margin="0,0,8,4"
                                    Click="BtnFillFullMarksAll_Click"/>

                            <Button x:Name="BtnFillFullMarksSelected" Content="✔ الدرجة الكاملة للمحددين"
                                    Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" Margin="0,0,8,4"
                                    Click="BtnFillFullMarksSelected_Click"/>

                            <Button x:Name="BtnClearMarksZero" Content="🔄 إعادة تهيئة الورقة"
                                    Style="{StaticResource SecondaryButton}" Height="34" Padding="10,0" Margin="0,0,8,4"
                                    ToolTip="مسح جميع الدرجات المدخلة في الورقة الحالية وإعادتها فارغة لإدخالها من جديد"
                                    Click="BtnClearMarksZero_Click"/>

                            <Button x:Name="BtnSaveMonthlyEvaluation" Content="💾 حفظ واعتماد تقييم الشهر"
                                    Style="{StaticResource PrimaryButton}" Height="34" Padding="16,0" Margin="0,0,0,4"
                                    Click="BtnSaveMonthlyEvaluation_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 2: جدول إدخال الدرجات الشهرية مع شريط تمرير أفقي ورأسي تلقائي -->
                <DataGrid Grid.Row="2" x:Name="GridWeeklyScores"
                          CanUserSortColumns="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          BeginningEdit="GridWeeklyScores_BeginningEdit"
                          PreparingCellForEdit="GridWeeklyScores_PreparingCellForEdit"
                          CellEditEnding="GridWeeklyScores_CellEditEnding">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasAnyEmptyCriteria}" Value="True"/>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="#FFFBEB"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>

                <!-- 3: الشريط السفلي لأوراق القالب -->
                <Border Grid.Row="3" x:Name="PanelBottomSheetsBar" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.5" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="📑 أوراق القالب:" Foreground="#1E3A8A" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0"/>

                        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="StackSheetTabs" Orientation="Horizontal" VerticalAlignment="Center"/>
                        </ScrollViewer>

                        <TextBlock Grid.Column="4" x:Name="TxtSheetAverageBadge"
                                   Text="متوسط درجات الورقة: 0 / 100"
                                   Foreground="#1E40AF" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" Margin="6,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- طبقة التحميل الدائرية أثناء قراءة ومطابقة ملف الإكسل -->
        <Border x:Name="ImportLoadingOverlay"
                Background="#CCFFFFFF"
                CornerRadius="10"
                Visibility="Collapsed"
                Panel.ZIndex="99">
            <Border Background="#FFFFFF" BorderBrush="#93C5FD" BorderThickness="1.5" CornerRadius="14"
                    Padding="28,22" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="330">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.16" Color="#0F172A"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="54" Height="54" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Ellipse Width="54" Height="54" Stroke="#E2E8F0" StrokeThickness="5"/>
                        <Path Width="54" Height="54"
                              Stroke="#2563EB" StrokeThickness="5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 27,2.5 A 24.5,24.5 0 0 1 48.22,39.25">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="ImportSpinnerRotate" Angle="0" CenterX="27" CenterY="27"/>
                            </Path.RenderTransform>
                            <Path.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="ImportSpinnerRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:0.85"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>
                    </Grid>
                    <TextBlock x:Name="TxtImportLoadingTitle"
                               Text="جاري استيراد ومطابقة التقييمات من Excel..."
                               FontSize="15" FontWeight="Bold" Foreground="#1E3A8A"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock x:Name="TxtImportLoadingSubtitle"
                               Text="يرجى الانتظار قليلاً حتى تكتمل قراءة الأوراق ومطابقة أسماء الموظفين وأعمدة المبادئ."
                               FontSize="12" Foreground="#64748B" Margin="0,6,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="350"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>







