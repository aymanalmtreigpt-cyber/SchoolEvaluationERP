<Window x:Class="SchoolEvaluationERP.Views.SelectEvaluatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اختيار المقيم وتحديد المستخدمين المسؤولين عن القالب"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBgBrush}"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Border Style="{StaticResource CardStyle}" Padding="20">
            <StackPanel>
                <TextBlock Text="إنشاء قالب تقييم جديد لمقيم" FontSize="17.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="اختر المقيم ثم حدد المستخدمين المسؤولين عن هذا القالب (المستخدمون المضافون فقط هم من يمكنهم التعامل مع القالب وإدخال تقييماته بالإضافة للمدير)."
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>

                <TextBlock Text="1. ابحث واختر اسم المقيم:" FontWeight="Bold" FontSize="12.5" Foreground="#1E3A8A" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtSearchEvaluator" Style="{StaticResource ModernTextBox}"
                         TextChanged="TxtSearchEvaluator_TextChanged" Margin="0,0,0,6"/>

                <ListBox x:Name="LstEvaluators" Height="155" BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC"
                         DisplayMemberPath="DisplayWithTemplateStatus" SelectedValuePath="EvaluatorID"
                         FontSize="13.5"
                         SelectionChanged="LstEvaluators_SelectionChanged"
                         MouseDoubleClick="LstEvaluators_MouseDoubleClick" Margin="0,0,0,12"/>

                <Border x:Name="PanelAssignUsers" Background="#F8FAFC" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="2. تحديد المستخدمين المسؤولين عن هذا القالب (اختياري الآن ويمكن تعديله لاحقاً):"
                                   FontWeight="Bold" FontSize="12.5" Foreground="#1E3A8A" TextWrapping="Wrap" Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" x:Name="CmbAssignUser"
                                      Style="{StaticResource ModernComboBox}" Height="34"
                                      DisplayMemberPath="DropdownDisplay" SelectedValuePath="UserID"/>

                            <Button Grid.Column="2" x:Name="BtnAddAssignedUser" Content="+ إضافة"
                                    Style="{StaticResource PrimaryButton}" Height="34" Padding="14,0" FontSize="12.5"
                                    Click="BtnAddAssignedUser_Click"/>
                        </Grid>

                        <TextBlock x:Name="TxtAssignUsersNote" Text="" FontSize="11.5" Foreground="#B45309" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed"/>

                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="6" MinHeight="62" MaxHeight="125">
                            <Grid>
                                <TextBlock x:Name="TxtNoSelectedUsersHint"
                                           Text="لم يتم تحديد مستخدمين بعد (سيظهر تحذير بجانب القالب لتحديده لاحقاً)."
                                           FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="6"/>

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ListSelectedUsers">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="6"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding ListDisplay}"
                                                                   FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#0F172A"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <Button Grid.Column="2" Content="🗑"
                                                                Tag="{Binding UserID}"
                                                                Style="{StaticResource DangerButton}"
                                                                Width="28" Height="26" Padding="0" FontSize="12"
                                                                ToolTip="حذف المستخدم من القائمة"
                                                                Click="BtnRemoveSelectedUser_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnCreate" Content="⚡ إنشاء / فتح قالب المقيم تلقائياً"
                            Style="{StaticResource PrimaryButton}" Height="40" IsDefault="True"
                            Click="BtnCreate_Click"/>

                    <Button Grid.Column="2" Content="إلغاء"
                            Style="{StaticResource SecondaryButton}" Height="40" IsCancel="True"
                            Click="BtnCancel_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
