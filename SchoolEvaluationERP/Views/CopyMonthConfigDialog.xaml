<Window x:Class="SchoolEvaluationERP.Views.CopyMonthConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نسخ ولصق أساسيات شهر إلى شهر آخر"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBgBrush}"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Border Style="{StaticResource CardStyle}" Padding="20">
            <StackPanel>
                <TextBlock Text="📋 نسخ ولصق أساسيات الشهر إلى شهر آخر"
                           FontSize="17.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="انسخ توزيع درجات الفئات وإسناد الموظفين للمقيمين من شهر مصدر إلى شهر هدف لتجهيز الشهر الجديد بسرعة قبل تعديله."
                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,14"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- الشهر المصدر -->
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="📤 نسخ من (الشهر المصدر):" FontWeight="Bold" FontSize="13" Foreground="#1E3A8A" Margin="0,0,0,8"/>
                            <TextBlock Text="السنة:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbSrcYear" Style="{StaticResource ModernComboBox}" Height="34" Margin="0,0,0,8"/>
                            <TextBlock Text="الشهر:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbSrcMonth" Style="{StaticResource ModernComboBox}" Height="34"
                                      DisplayMemberPath="DisplayText" SelectedValuePath="MonthNumber"/>
                        </StackPanel>
                    </Border>

                    <!-- الشهر الهدف -->
                    <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1.5" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="📥 لصق في (الشهر الهدف):" FontWeight="Bold" FontSize="13" Foreground="#047857" Margin="0,0,0,8"/>
                            <TextBlock Text="السنة:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbDstYear" Style="{StaticResource ModernComboBox}" Height="34" Margin="0,0,0,8"/>
                            <TextBlock Text="الشهر:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbDstMonth" Style="{StaticResource ModernComboBox}" Height="34"
                                      DisplayMemberPath="DisplayText" SelectedValuePath="MonthNumber"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="العناصر المشمولة في النسخ:" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkCopyWeights" Content="توزيع درجات الفئات ومجموعات المقيمين (100 درجة)" IsChecked="True" FontSize="12.5" Margin="0,0,0,6"/>
                        <CheckBox x:Name="ChkCopyAssignments" Content="إسناد الموظفين للمقيمين وحالات الموظفين (الفئة / الحافز / الدوام)" IsChecked="True" FontSize="12.5" Margin="0,0,0,6"/>
                        <CheckBox x:Name="ChkCopyIncentives" Content="حدود الحوافز الشهرية للفئات (الحد الأعلى والأدنى — إن وجدت)" IsChecked="False" FontSize="12.5"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnExecuteCopy"
                            Content="✔ تنفيذ النسخ واللصق الآن"
                            Style="{StaticResource PrimaryButton}" Height="40"
                            Click="BtnExecuteCopy_Click"/>

                    <Button Grid.Column="2" Content="إلغاء"
                            Style="{StaticResource SecondaryButton}" Height="40"
                            IsCancel="True"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
