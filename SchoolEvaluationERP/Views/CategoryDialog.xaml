<Window x:Class="SchoolEvaluationERP.Views.CategoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تجهيز الفئة وتوزيع درجات المقيمين (100 درجة)"
        Height="580" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBgBrush}"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">

    <Grid Margin="18">
        <Border Style="{StaticResource CardStyle}" Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock x:Name="TxtDialogTitle" Text="إنشاء فئة جديدة وتوزيع درجات المقيمين" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="حدد اسم الفئة والفرع، ثم اختر المقيمين عبر (CheckBox) ووزع الدرجات بينهم بحيث يكون المجموع = 100 درجة." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="اسم الفئة (مثلاً: معلم، مشرف، إداري)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtCategoryName" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="الفرع التابعة له الفئة" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbBranch" Style="{StaticResource ModernComboBox}"
                                  DisplayMemberPath="BranchName" SelectedValuePath="BranchID"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" x:Name="CounterBanner" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtTotalScoreStatus" Text="مجموع درجات المقيمين الحالي: 0 من 100 درجة" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="توزيع بالتساوي" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" FontSize="12" Click="BtnDistributeEqually_Click" ToolTip="توزيع الـ 100 درجة بالتساوي على المقيمين المحددين"/>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="3" x:Name="GridEvaluators" CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="اختيار" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                        <DataGridTextColumn Header="اسم المقيم" Binding="{Binding EvaluatorName}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="الدرجة المخصصة (من 100)" Binding="{Binding WeightScore, UpdateSourceTrigger=PropertyChanged}" Width="165"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="4" Text="💡 تلميح: ضع علامة صح بجانب المقيم ثم اكتب الدرجة المخصصة له في العمود المقابل (أو اضغط توزيع بالتساوي)." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,14"/>

                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnSaveCategory" Content="💾 حفظ الفئة واعتماد أوزان المقيمين (100 درجة)"
                            Style="{StaticResource PrimaryButton}" IsDefault="True"
                            Click="BtnSaveCategory_Click"/>

                    <Button Grid.Column="2" Content="إلغاء"
                            Style="{StaticResource SecondaryButton}" IsCancel="True"
                            Click="BtnCancel_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
