<UserControl x:Class="SchoolEvaluationERP.Views.DatabaseBackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI">

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 0: ملخص حالة قاعدة البيانات الحالية -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="إدارة النسخ الاحتياطي واستعادة قاعدة البيانات (خاص بمدير النظام Admin)"
                                   FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtDbConnectionInfo"
                                   Text="قاعدة البيانات النشطة: SchoolEvaluationDB"
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="🔄 تحديث إحصائيات القاعدة"
                            Style="{StaticResource SecondaryButton}" Height="36" Padding="14,0"
                            Click="BtnRefreshStats_Click"/>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="الفروع والفئات" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtStatBranchesCats" Text="0 فرع / 0 فئة" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="إجمالي المقيمين" FontSize="12" Foreground="#1E40AF" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtStatEvaluators" Text="0 مقيم" FontSize="15.5" FontWeight="Bold" Foreground="#1E40AF" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="إجمالي الموظفين" FontSize="12" Foreground="#047857" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtStatEmployees" Text="0 موظف" FontSize="15.5" FontWeight="Bold" Foreground="#047857" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="قوالب التقييم الفعالة" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtStatTemplates" Text="0 قالب" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="8" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="12,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="سجلات التقييم الشهرية" FontSize="12" Foreground="#92400E" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtStatRecords" Text="0 سجل" FontSize="15.5" FontWeight="Bold" Foreground="#92400E" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="10" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="حسابات المستخدمين" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtStatUsers" Text="0 مستخدم" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 1: قسم إنشاء النسخة الاحتياطية + قسم استعادة النسخة الاحتياطية -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- البطاقة اليمنى: إنشاء نسخة احتياطية جديدة (Backup) -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="22">
                <StackPanel>
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="📥 1. إنشاء نسخة احتياطية لقاعدة البيانات (Backup)"
                                       FontSize="16.5" FontWeight="Bold" Foreground="#1E3A8A"/>
                            <TextBlock Text="يحفظ نسخة كاملة من جميع بيانات النظام (الفروع، الفئات، حدود الحوافز، المقيمين، الموظفين، القوالب، التقييمات الشهرية، نسب الموازنة، وحسابات المستخدمين) في المكان الذي تحدده."
                                       FontSize="12.5" Foreground="#1E40AF" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="مكان تخزين واسم ملف النسخة الاحتياطية:" FontWeight="Bold" FontSize="13.5" Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" x:Name="TxtBackupTargetPath"
                                 Style="{StaticResource ModernTextBox}"
                                 FlowDirection="LeftToRight"
                                 ToolTip="مسار حفظ ملف النسخة الاحتياطية"/>

                        <Button Grid.Column="2" Content="📂 تحديد مكان الحفظ..."
                                Style="{StaticResource SecondaryButton}" Height="38" Padding="14,0"
                                Click="BtnBrowseBackupTarget_Click"/>
                    </Grid>

                    <TextBlock Text="💡 يمكنك حفظ النسخة بصيغة SQL Server القياسية (.bak) أو بصيغة النسخة الشاملة المحمولة (.erpbackup) على القرص الصلب أو فلاش خارجي (USB)."
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>

                    <Button x:Name="BtnExecuteBackup"
                            Content="💾 إنشاء وحفظ النسخة الاحتياطية الآن"
                            Style="{StaticResource PrimaryButton}"
                            Height="44" FontSize="14.5"
                            Click="BtnExecuteBackup_Click"/>

                    <Border x:Name="BannerBackupStatus" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,16,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="TxtBackupStatusMessage" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#047857" FontSize="12.5"/>
                    </Border>
                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource VerticalGridSplitterStyle}" ToolTip="اسحب لتغيير عرض بطاقتي النسخ الاحتياطي والاستعادة"/>

            <!-- البطاقة اليسرى: استعادة نسخة احتياطية سابقة (Restore) -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="22">
                <StackPanel>
                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="♻️ 2. استعادة قاعدة البيانات من نسخة احتياطية (Restore)"
                                       FontSize="16.5" FontWeight="Bold" Foreground="#92400E"/>
                            <TextBlock Text="يتيح لك استرجاع قاعدة البيانات بالكامل من أي نسخة احتياطية سابقة قمت بحفظها (.bak أو .erpbackup) في أي وقت."
                                       FontSize="12.5" Foreground="#B45309" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ملف النسخة الاحتياطية المراد استعادته:" FontWeight="Bold" FontSize="13.5" Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" x:Name="TxtRestoreSourcePath"
                                 Style="{StaticResource ModernTextBox}"
                                 FlowDirection="LeftToRight"
                                 ToolTip="اختر ملف النسخة الاحتياطية (.bak أو .erpbackup) المراد استعادته"/>

                        <Button Grid.Column="2" Content="📂 اختيار ملف النسخة..."
                                Style="{StaticResource SecondaryButton}" Height="38" Padding="14,0"
                                Click="BtnBrowseRestoreSource_Click"/>
                    </Grid>

                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,18">
                        <TextBlock Text="⚠️ تنبيه هام: عند استعادة نسخة احتياطية، سيتم استبدال البيانات الحالية في النظام ببيانات النسخة الاحتياطية المختارة. يُنصح بأخذ نسخة احتياطية للوضع الحالي أولاً قبل الاستعادة."
                                   FontSize="12" Foreground="#B91C1C" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>

                    <Button x:Name="BtnExecuteRestore"
                            Content="♻️ استعادة قاعدة البيانات من الملف المحدد الآن"
                            Style="{StaticResource DangerButton}"
                            Height="44" FontSize="14.5"
                            Click="BtnExecuteRestore_Click"/>

                    <Border x:Name="BannerRestoreStatus" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,16,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="TxtRestoreStatusMessage" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#047857" FontSize="12.5"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

