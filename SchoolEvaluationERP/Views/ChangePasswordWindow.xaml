<Window x:Class="SchoolEvaluationERP.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تغيير كلمة المرور الخاصة بالحساب"
        Height="470" Width="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource AppBgBrush}"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Border Style="{StaticResource CardStyle}" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="TxtHeaderTitle" Text="تعيين كلمة مرور جديدة للحساب"
                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,6"/>

                <TextBlock x:Name="TxtSubTitle"
                           Text="أهلاً بك! نظراً لأن هذا الحساب جديد أو تمت إعادة تهيئته من الإدارة، يرجى تعيين كلمة مرور خاصة بك."
                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,18"/>

                <StackPanel x:Name="CurrentPasswordPanel" Margin="0,0,0,14">
                    <TextBlock Text="كلمة المرور الحالية / المستلمة من المدير" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TxtCurrentPassword" Style="{StaticResource ModernPasswordBox}"/>
                </StackPanel>

                <TextBlock Text="كلمة المرور الجديدة" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <PasswordBox x:Name="TxtNewPassword" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,14"/>

                <TextBlock Text="تأكيد كلمة المرور الجديدة" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <PasswordBox x:Name="TxtConfirmPassword" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,16"/>

                <Border x:Name="ErrorBanner" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14" Visibility="Collapsed">
                    <TextBlock x:Name="TxtError" Foreground="#B91C1C" FontSize="12.5" TextWrapping="Wrap"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnSave" Content="حفظ واعتماد كلمة المرور"
                            Style="{StaticResource PrimaryButton}" IsDefault="True"
                            Click="BtnSave_Click"/>

                    <Button Grid.Column="2" Content="إلغاء"
                            Style="{StaticResource SecondaryButton}" IsCancel="True"
                            Click="BtnCancel_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
