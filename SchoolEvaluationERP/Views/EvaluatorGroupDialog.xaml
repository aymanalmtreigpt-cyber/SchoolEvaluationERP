<Window x:Class="SchoolEvaluationERP.Views.EvaluatorGroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إنشاء وتعديل مجموعة مقيمين"
        Width="580" Height="590"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="460" MinHeight="440"
        Background="{StaticResource AppBgBrush}"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">

    <Grid Margin="18">
        <Border Style="{StaticResource CardStyle}" Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- العنوان والتوضيح -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock x:Name="TxtDialogTitle" Text="إنشاء مجموعة مقيمين جديدة" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="أدخل اسماً واضحاً للمجموعة لتمييزها عند تخصيص الـ 100 درجة للفئات، ثم أضف مقيمين بداخلها (شخص واحد = مسؤول عام على الفئة بكل الفروع، عدة أشخاص = مجموعة تقسم الدرجة بينهم حسب الإسناد)."
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- اسم المجموعة -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="اسم مجموعة المقيمين (مثلاً: مشرفو المواد، الإدارة العامة، وكلاء الفروع):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtGroupName" Style="{StaticResource ModernTextBox}"/>
                </StackPanel>

                <!-- إضافة مقيم للقائمة -->
                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="إضافة اسم مقيم داخل هذه المجموعة (اكتب الاسم ثم اضغط Enter أو زر إضافة):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtNewMemberName" Style="{StaticResource ModernTextBox}"
                                 KeyDown="TxtNewMemberName_KeyDown"/>
                        <Button Grid.Column="2" Content="➕ إضافة للمجموعة" Style="{StaticResource SecondaryButton}"
                                Height="38" Padding="14,0" Click="BtnAddMember_Click"/>
                    </Grid>
                </StackPanel>

                <!-- شارة حالة المجموعة التلقائية -->
                <Border Grid.Row="3" x:Name="BannerGroupRule" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                    <TextBlock x:Name="TxtGroupRuleHint"
                               Text="أضف اسماً واحداً على الأقل داخل المجموعة..."
                               FontSize="12.5" FontWeight="SemiBold" Foreground="#1E40AF" TextWrapping="Wrap"/>
                </Border>

                <!-- جدول أسماء المقيمين في المجموعة (قابل لتعديل الاسم مباشرة أو الحذف) -->
                <DataGrid Grid.Row="4" x:Name="GridMembers" CanUserSortColumns="False" Margin="0,0,0,14">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم المقيم (يمكنك النقر مرتين لتعديله)"
                                            Binding="{Binding EvaluatorName, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"/>
                        <DataGridTemplateColumn Header="إزالة" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑 حذف"
                                            Style="{StaticResource DangerButton}"
                                            Height="28" Padding="8,0" FontSize="11.5"
                                            Click="BtnRemoveMemberRow_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- أزرار الحفظ والإلغاء -->
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnSaveGroup" Content="💾 حفظ مجموعة المقيمين"
                            Style="{StaticResource PrimaryButton}" Height="42"
                            Click="BtnSaveGroup_Click"/>

                    <Button Grid.Column="2" Content="إلغاء"
                            Style="{StaticResource SecondaryButton}" Height="42" IsCancel="True"
                            Click="BtnCancel_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

