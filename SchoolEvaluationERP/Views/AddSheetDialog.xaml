<Window x:Class="SchoolEvaluationERP.Views.AddSheetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعداد ورقة تقييم داخل القالب"
        Width="510" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBgBrush}"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">

    <Grid Margin="18">
        <Border Style="{StaticResource CardStyle}" Padding="22">
            <StackPanel>
                <TextBlock x:Name="TxtDialogTitle" Text="إضافة ورقة عمل (Sheet) جديدة في القالب" FontSize="17.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="أدخل اسم الورقة (أو اترك الاسم الافتراضي)، ثم حدد الفئة والفرع (أو كلاهما لعرض الموظفين المسندين لهذا المقيم في كل الفروع)."
                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,16"/>

                <TextBlock Text="تسمية الورقة (مثلاً: ورقة تقييم المعلمين):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtSheetName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                <TextBlock Text="الفئة المرتبطة بالمقيم:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="CmbCategoryName"
                          Style="{StaticResource ModernComboBox}"
                          DisplayMemberPath="DropdownDisplay"
                          SelectedValuePath="CategoryID"
                          SelectionChanged="CmbCategoryName_SelectionChanged"
                          Margin="0,0,0,14"/>

                <TextBlock Text="تحديد الفرع (أو جميع الفروع / كلاهما):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="CmbBranchFilter"
                          Style="{StaticResource ModernComboBox}"
                          DisplayMemberPath="DropdownDisplay"
                          Margin="0,0,0,20"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnConfirmSheet" Content="➕ إنشاء الورقة"
                            Style="{StaticResource PrimaryButton}" Height="42" IsDefault="True"
                            Click="BtnConfirmSheet_Click"/>

                    <Button Grid.Column="2" Content="إلغاء"
                            Style="{StaticResource SecondaryButton}" Height="42" IsCancel="True"
                            Click="BtnCancel_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
