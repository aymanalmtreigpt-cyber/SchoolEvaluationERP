<Window x:Class="SchoolEvaluationERP.Views.SmallTextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدخال الاسم"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">

    <Grid Margin="14">
        <Border Style="{StaticResource CardStyle}" Padding="18">
            <StackPanel>
                <TextBlock x:Name="TxtPromptTitle"
                           Text="إضافة عنصر جديد"
                           FontSize="16.5"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,12"/>

                <TextBlock x:Name="TxtFieldLabel"
                           Text="الاسم:"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="TxtInputValue"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,16"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="105"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            x:Name="BtnConfirm"
                            Content="إضافة"
                            Style="{StaticResource PrimaryButton}"
                            Height="38"
                            IsDefault="True"
                            Click="BtnConfirm_Click"/>

                    <Button Grid.Column="2"
                            Content="إلغاء"
                            Style="{StaticResource SecondaryButton}"
                            Height="38"
                            IsCancel="True"
                            Click="BtnCancel_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
