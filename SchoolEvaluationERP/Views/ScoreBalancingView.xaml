<UserControl x:Class="SchoolEvaluationERP.Views.ScoreBalancingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI">

    <Grid Margin="4">
        <Border Style="{StaticResource CardStyle}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 0: شريط تحديد السنة والشهر واسم المقيم -->
                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="نسب الموازنة ومعالجة نسب التقييم غير المنطقية للمقيمين"
                                       FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="حدد السنة والشهر واسم المقيم لفتح سجل تقييمه الشهري، ثم قم بزيادة أو تنقيص نسبة التقييم لجميع الموظفين في قالب المقيم أو ابحث عن موظف محدد لزيادة أو تنقيص نسبته."
                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.8*" MinWidth="95"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.1*" MinWidth="125"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="2.3*" MinWidth="200"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="1. السنة:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbYear" Style="{StaticResource ModernComboBox}" Height="36"
                                          SelectionChanged="PeriodFilter_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="2. الشهر:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbMonth" Style="{StaticResource ModernComboBox}" Height="36"
                                          DisplayMemberPath="DisplayText" SelectedValuePath="MonthNumber"
                                          SelectionChanged="PeriodFilter_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="3. اختيار سجل المقيم (اسم المقيم ومتوسط تقييمه الحالي):" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbEvaluatorRecord" Style="{StaticResource ModernComboBox}" Height="36"
                                          IsEditable="True" StaysOpenOnEdit="True"
                                          DisplayMemberPath="DropdownRecordDisplay" SelectedValuePath="RecordID"
                                          SelectionChanged="CmbEvaluatorRecord_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                                <Button x:Name="BtnReloadRecords" Content="🔄 تحديث السجلات"
                                        Style="{StaticResource SecondaryButton}" Height="36" Padding="12,0"
                                        Click="BtnReloadRecords_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 1: شريط موازنة جميع الموظفين في قالب المقيم + زر الحفظ -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtOpenedRecordHeader"
                                           Text="لم يتم فتح سجل تقييم بعد — اختر السنة والشهر واسم المقيم من الأعلى"
                                           FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,2"/>

                                <Border x:Name="BadgeRecordAverage" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,3" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtBadgeRecordAverage" Text="متوسط القالب بعد الموازنة: 0%" Foreground="#1E40AF" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"/>
                                </Border>
                            </WrapPanel>

                            <Button Grid.Column="2" x:Name="BtnSaveBalancing" Content="💾 حفظ واعتماد نسب الموازنة"
                                    Style="{StaticResource PrimaryButton}" Height="36" Padding="16,0" IsEnabled="False"
                                    Click="BtnSaveBalancing_Click"/>
                        </Grid>

                        <WrapPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚖ موازنة جماعية لجميع موظفي القالب:" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,4"/>

                            <TextBlock Text="المقدار:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                            <TextBox x:Name="TxtBulkDeltaValue" Style="{StaticResource ModernTextBox}" Width="75" Height="34" Text="5"
                                     FontWeight="Bold" TextAlignment="Center" Margin="0,0,8,4"/>

                            <Button x:Name="BtnIncreaseAllTemplate" Content="➕ زيادة لجميع موظفي القالب (+)"
                                    Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" Margin="0,0,8,4"
                                    Foreground="#047857" BorderBrush="#6EE7B7" IsEnabled="False"
                                    Click="BtnIncreaseAllTemplate_Click"/>

                            <Button x:Name="BtnDecreaseAllTemplate" Content="➖ تنقيص لجميع موظفي القالب (-)"
                                    Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" Margin="0,0,8,4"
                                    Foreground="#B91C1C" BorderBrush="#FCA5A5" IsEnabled="False"
                                    Click="BtnDecreaseAllTemplate_Click"/>

                            <Button x:Name="BtnResetAllTemplateZero" Content="🧹 تصفير موازنة القالب (0)"
                                    Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" Margin="0,0,0,4"
                                    IsEnabled="False"
                                    Click="BtnResetAllTemplateZero_Click"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- 2: شريط البحث عن اسم موظف في القالب وزيادة أو تنقيص نسبته (مرن عبر WrapPanel) -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍 بحث عن اسم موظف:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,2,6,4"/>
                            <TextBox x:Name="TxtSearchEmployee" Style="{StaticResource ModernTextBox}" Width="210" Height="34" Margin="0,2,6,4"
                                     ToolTip="اكتب اسم الموظف للبحث عنه داخل الورقة..."
                                     TextChanged="TxtSearchEmployee_TextChanged"/>
                            <Button Content="إظهار الكل" Style="{StaticResource SecondaryButton}" Height="34" Padding="10,0" FontSize="12" Margin="0,2,14,4"
                                    Click="BtnClearSearch_Click"/>

                            <TextBlock Text="مقدار للموظف المحدد:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,2,6,4"/>
                            <TextBox x:Name="TxtIndividualDeltaValue" Style="{StaticResource ModernTextBox}" Width="68" Height="34" Text="2"
                                     FontWeight="Bold" TextAlignment="Center" Margin="0,2,6,4"/>

                            <Button x:Name="BtnIncreaseSelectedEmp" Content="➕ زيادة للموظف (+)"
                                    Style="{StaticResource SecondaryButton}" Height="34" Padding="10,0" FontSize="12.5" Margin="0,2,6,4"
                                    Foreground="#047857" BorderBrush="#6EE7B7" IsEnabled="False"
                                    Click="BtnIncreaseSelectedEmp_Click"/>

                            <Button x:Name="BtnDecreaseSelectedEmp" Content="➖ تنقيص للموظف (-)"
                                    Style="{StaticResource SecondaryButton}" Height="34" Padding="10,0" FontSize="12.5" Margin="0,2,6,4"
                                    Foreground="#B91C1C" BorderBrush="#FCA5A5" IsEnabled="False"
                                    Click="BtnDecreaseSelectedEmp_Click"/>

                            <Button x:Name="BtnResetSelectedEmp" Content="0 تصفير"
                                    Style="{StaticResource SecondaryButton}" Height="34" Padding="8,0" FontSize="12" Margin="0,2,8,4"
                                    IsEnabled="False"
                                    Click="BtnResetSelectedEmp_Click"/>
                        </WrapPanel>

                        <TextBlock Grid.Column="1" x:Name="TxtFilteredCountBadge" Text="الموظفون: 0" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </Border>

                <!-- 3: جدول عرض درجات مبادئ التقييم وبجانبها عمود (نسبة الموازنة +/-) -->
                <DataGrid Grid.Row="3" x:Name="GridBalancingScores"
                          CanUserSortColumns="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"/>

                <!-- 4: الشريط السفلي لأوراق القالب ومتوسط الورقة قبل وبعد الموازنة -->
                <Border Grid.Row="4" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.5" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="📑 أوراق القالب:" Foreground="#1E3A8A" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0"/>

                        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="StackSheetTabs" Orientation="Horizontal" VerticalAlignment="Center"/>
                        </ScrollViewer>

                        <TextBlock Grid.Column="4" x:Name="TxtSheetAverageComparison"
                                   Text="متوسط الورقة قبل الموازنة: 0%  |  بعد الموازنة: 0%"
                                   Foreground="#1E40AF" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" Margin="6,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
